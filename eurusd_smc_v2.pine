// This Pine Script(tm) code is subject to the terms of the Mozilla Public License 2.0
// Liquidity Algo — POI liquidated > structure break (CE) > entry
// POIs: 1H/4H/D/W/MN imbalances (FVG), PDH/PDL, PWH/PWL, EQH/EQL | CE = close beyond the swing that started the final leg
// Kill Zones: Asia 00:00-08:00 | London 09:00-11:00 | NY 14:00-16:30 (UTC+2)
// Risk: Tiered non-compounded 1.00%-1.55% (+0.11/attempt) | SL=reaction extreme | TP=SLxRR
// Execution: 1-minute chart only, London/NY sessions, max 2 trades per session

//@version=6
strategy(
    title             = "Liquidity Algo",
    shorttitle        = "LiqAlgo",
    overlay           = true,
    default_qty_type  = strategy.fixed,
    default_qty_value = 1,
    initial_capital   = 100000,
    currency          = currency.USD,
    commission_type   = strategy.commission.cash_per_contract,
    commission_value  = 0.00005,
    slippage          = 2,
    pyramiding        = 0,
    // THE reason zero trades were ever reaching the Strategy Tester despite
    // valid signals firing and the on-chart markers rendering correctly.
    // Pine v6 defaults margin_long/margin_short to 100% when left unset —
    // i.e. it simulates a CASH account that must hold the full notional
    // value of a position, no leverage. Our position sizing (f_qty) computes
    // qty from real risk management (1-1.55% of fixed_cap divided by the
    // stop distance in price), which for a tight stop routinely comes out to
    // hundreds of thousands or millions of units of EURUSD — a notional
    // value of hundreds of thousands to millions of USD, against a $100,000
    // initial_capital. At 100% margin that is never affordable, so every
    // single strategy.entry() call was being silently rejected by the
    // simulated broker: no error banner, the order simply never fills, which
    // is exactly "the marker shows on the chart but nothing is in the trade
    // list" — the marker only reflects the SIGNAL (short_valid/long_valid),
    // not whether the order actually executed. This is forex traded on
    // leverage, not a cash account buying shares, so margin_long/short = 0
    // removes that constraint entirely and lets qty reflect pure leveraged
    // exposure — our own risk-per-trade sizing is already the real risk
    // control, TradingView's cash-margin model was never the right model
    // for this instrument.
    // Ticks recalculate the script on the live bar so every chart timeframe
    // draws its zones from the CURRENT price and clock (otherwise a D chart
    // would show yesterday's state). Orders are still placed only once, on
    // the bar's close (order_bar), exactly as before.
    calc_on_every_tick = true,
    margin_long       = 0,
    margin_short      = 0,
    max_bars_back     = 500,
    // Pine defaults to 50 of each. The POI manager alone can hold a dozen
    // lines + labels at once, plus the entry-FVG pair, the MSS reference and
    // the session boxes — over a long backtest / bar replay the oldest
    // drawings get silently evicted at the default cap, which looks like
    // "zones randomly disappearing". Explicit headroom avoids that.
    max_lines_count   = 500,
    max_labels_count  = 500,
    max_boxes_count   = 500)

// =============================================================
// INPUTS
// =============================================================

// Everything about a session — its time window, whether its box shows, its
// label, and its color — lives together here, instead of the times being
// under "Kill Zones" and the box appearance under "Visuals". All hours are
// UTC+2 (matches typical broker/exchange chart time, e.g. FXCM feeds).
var string GSESS = "Market Sessions (UTC+2)"

show_session_labels = input.bool(false, "Show Session Name Labels (Asia/London/New York text)", group = GSESS)

show_asia_box = input.bool(true,  "Asia",   group = GSESS, inline = "asia1")
asia_box_txt  = input.string("Asia", "Label", group = GSESS, inline = "asia1")
asia_box_col  = input.color(color.red, "Color", group = GSESS, inline = "asia1")
kz_asia_open  = input.int(0, "Open (h)",  0, 23, group = GSESS, inline = "asia2")
kz_asia_close = input.int(8, "Close (h)", 0, 23, group = GSESS, inline = "asia2")

show_lon_box = input.bool(true,  "London", group = GSESS, inline = "lon1")
lon_box_txt  = input.string("London", "Label", group = GSESS, inline = "lon1")
lon_box_col  = input.color(color.green, "Color", group = GSESS, inline = "lon1")
kz_lon_open  = input.int(9,  "Open (h)",  0, 23, group = GSESS, inline = "lon2")
kz_lon_close = input.int(11, "Close (h)", 0, 23, group = GSESS, inline = "lon2")

show_ny_box   = input.bool(true,  "New York", group = GSESS, inline = "ny1")
ny_box_txt    = input.string("New York", "Label", group = GSESS, inline = "ny1")
ny_box_col    = input.color(color.blue, "Color", group = GSESS, inline = "ny1")
kz_ny_open    = input.int(14, "Open (h)",    0, 23, group = GSESS, inline = "ny2")
kz_ny_close_h = input.int(16, "Close (h)",   0, 23, group = GSESS, inline = "ny2")
kz_ny_close_m = input.int(30, "Close (min)", 0, 59, group = GSESS, inline = "ny2")

sess_box_max = input.int(3, "Max Boxes per Session (oldest dropped)", 2, 30, group = GSESS)

var string GLIQ = "Liquidity Levels (HTF POIs)"
use_pdhl  = input.bool(true,    "PDH / PDL (Previous Day)",  group = GLIQ)
use_pwhl  = input.bool(true,    "PWH / PWL (Previous Week)", group = GLIQ)
sw_len    = input.int(10,       "EQH/EQL Pivot Strength (ref-TF candles each side)",  2, 50, group = GLIQ)
sweep_buf = input.float(0.0002, "Sweep Buffer", 0.00005, 0.001, 0.00001, group = GLIQ)

var string GMSS = "MSS Settings"
mss_max_bars = input.int(150, "Max Bars for MSS (whole cycle deadline after the sweep)", 5, 500, group = GMSS, tooltip = "How long the bot keeps hunting for the structure break after a zone is liquidated. Price often sweeps a level and then keeps running for another 50-80 bars before the actual reaction, so a short deadline kills the setup right before the trade it was waiting for. A cycle is also abandoned immediately if the session it armed in ends first (Asia/London/NY) — it never waits across a session boundary — so this deadline mainly matters for setups that time out within the same session.")
ce_leg_pct   = input.float(25.0, "CE: Min Pullback (% of final leg)", 5.0, 100.0, 5.0, group = GMSS, tooltip = "CE = the swing that STARTED the final leg into the liquidity (short: the low the last push up began from; long: the high the last push down began from). A pullback only counts as the start of a leg if it is at least this % of the leg that followed it, so small pauses inside one push are ignored.")
ce_min_atr   = input.float(1.0,  "CE: Min Pullback (x ATR 14)", 0.0, 5.0, 0.1, group = GMSS, tooltip = "Absolute floor for the same pullback, in ATR(14) of the chart: stops 1-2 candle micro-dips from becoming the CE.")
ce_leg_cap_atr = input.float(1.25, "CE: Cap of the %-of-leg pullback term (x ATR 14)", 0.5, 5.0, 0.05, group = GMSS, tooltip = "The '% of final leg' part of the pullback threshold can never exceed this many ATR. Without a cap, on a long rally with shallow pullbacks the CE jumps to the origin of the whole move, far from price.")
ce_scan_bars = input.int(60,     "CE: Lookback (candles)", 10, 300, group = GMSS, tooltip = "How far back from the extreme the start of the final leg is searched. If no qualifying pullback exists in this window (one straight impulse), the CE is the lowest low (short) / highest high (long) of the window.")
ce_cont_bars = input.int(8,      "Continuation CE: min candles since the broken swing", 2, 100, group = GMSS, tooltip = "Audit layer only. A CE in the direction of the trend (a close beyond the last extreme after a pullback) is drawn only if that extreme is at least this many candles old ...")
ce_cont_atr  = input.float(2.0,  "Continuation CE: min pullback (x ATR 14)", 0.5, 10.0, 0.1, group = GMSS, tooltip = "... and the pullback between it and the break was at least this many ATR. Micro-swings inside a trend (a 2-5 candle bounce) are not structure. Reversal CEs are not affected.")
ce_disp_atr  = input.float(0.75, "CE: Displacement candle (min body x ATR 14)", 0.1, 3.0, 0.05, group = GMSS, tooltip = "When the candle that made the extreme is itself a strong candle in the push direction (a big green candle that dips and closes above the previous high, for a short setup), its own low IS the start of the move and can be the CE (e.g. a green candle that went a little deeper than the red one before it). Ordinary small candles never count: their own wick is part of the reversal, not the start of the leg.")
ce_leg_bars  = input.int(3,      "Continuation CE: min candles of the counter-move", 1, 30, group = GMSS, tooltip = "Audit layer only. A counter-move only counts as a leg (whose origin, when broken, is a CE) if at least this many candles separate the extreme from the bottom of the pullback. One big candle against a trend is not a leg: breaking its origin is just the trend making a new high/low, not a change of structure.")
ce_piv_bars  = input.int(5,      "CE: Displacement base lookback (candles)", 1, 20, group = GMSS, tooltip = "When the extreme was made by a displacement candle (see above), the CE is the last swing (3-candle low for a short setup / high for a long one) within this many candles before it: the base the impulse started from, even if that pause is smaller than a normal pullback. Without a swing in that window the usual pullback scan is used.")
ce_run_bars  = input.int(3,      "CE: Displacement impulse run (min candles)", 2, 10, group = GMSS, tooltip = "When a displacement candle ends a run of at least this many consecutive candles in the same direction (an impulse), the CE is the origin of that run: the deeper wick of the pause candle before it and the first candle of the run, even when that pause is smaller than a normal pullback.")
ce_hist      = input.bool(true,  "Show every CE in the sessions (analysis)", group = GMSS, tooltip = "Draws every CE inside Asia/London/NY on the 1-minute chart, trade or no trade, with the same rules the entries use: a candle CLOSING beyond structure (reversal or continuation). A wick beyond a level without closing is annulled and draws nothing.")
ce_hist_max  = input.int(150,    "Max CEs shown", 10, 200, group = GMSS)

var string GFVG = "FVG / Imbalance"
use_fvg_entry = input.bool(false, "Wait for the imbalance retest (otherwise enter on the CE candle)", group = GFVG, tooltip = "OFF (default): liquidity is taken, the CE level is broken, and the order goes in on that very candle. ON: after the break the bot waits for price to come back and retest the imbalance the reaction left behind.")
fvg_min_gap   = input.float(0.0002, "Min FVG Gap",  0.00005, 0.002, 0.00001, group = GFVG)
fvg_max_bars  = input.int(30,       "FVG Max Age (bars to wait for the retest before cancelling)",  5, 300, group = GFVG, tooltip = "How long a locked entry zone stays valid waiting for price to come back and retest it. On 1m this is minutes. 60 was letting setups fire an hour after the structure break.")
fvg_search_bars = input.int(8,      "Bars after MSS to find entry FVG", 1, 50, group = GFVG, tooltip = "The reaction-leg window. Imbalances are only picked up during this many bars after the structure break; the closest/newest one within it wins, and the zone is then LOCKED so it can't drift up the impulse.")
req_close_fvg = input.bool(true,    "Entry candle must CLOSE inside FVG", group = GFVG)

var string GHTF = "HTF Context Filter"
use_htf     = input.bool(false, "Require HTF FVG alignment (at least one active TF) — heavy filter", group = GHTF)
use_htf_1h  = input.bool(true,  "1H FVG zones",      group = GHTF)
use_htf_4h  = input.bool(true,  "4H FVG zones",      group = GHTF)
use_htf_d   = input.bool(true,  "Daily FVG zones",   group = GHTF)
use_htf_w   = input.bool(true,  "Weekly FVG zones",  group = GHTF)
use_htf_m   = input.bool(false, "Monthly FVG zones", group = GHTF)
htf_fvg_min = input.float(0.0003, "Min HTF FVG Size", 0.00010, 0.010, 0.00010, group = GHTF)
use_htf_imb_entry = input.bool(true, "Arm cycle when price manipulates an active HTF imbalance (like other POI)", group = GHTF, tooltip = "Treats an active 1H+ imbalance zone (from the toggles above) as a POI: the instant price enters/manipulates it, the cycle arms and waits for the usual structural break (CE/MSS) before entering — no liquidity sweep required first.")

var string GRSK = "Risk Management"
rr_ratio   = input.float(2.0,    "RR Ratio",         1.0, 10.0, 0.1,    group = GRSK)
max_sl     = input.float(0.0050, "Max SL Distance",  0.0005, 0.0200, 0.0001, group = GRSK)
min_sl     = input.float(0.0003, "Min SL Distance",  0.0001, 0.0020, 0.0001, group = GRSK)
max_day_tr = input.int(4,        "Max Trades / Day (overall ceiling)", 1, 10,   group = GRSK)
sess_max_trades = input.int(2,   "Max Trades per Session (London/NY only)", 1, 5, group = GRSK)
cap_sl_to_max = input.bool(true, "Cap SL at Max Distance instead of skipping trade", group = GRSK)
fixed_cap  = input.float(100000, "Fixed Capital (non-compounded)",       group = GRSK)

var string GTR = "Tiered Risk (% of Fixed Capital)"
r1 = input.float(1.00, "Attempt 1 (%)", 0.1, 5.0, 0.01, group = GTR) / 100
r2 = input.float(1.11, "Attempt 2 (%)", 0.1, 5.0, 0.01, group = GTR) / 100
r3 = input.float(1.22, "Attempt 3 (%)", 0.1, 5.0, 0.01, group = GTR) / 100
r4 = input.float(1.33, "Attempt 4 (%)", 0.1, 5.0, 0.01, group = GTR) / 100
r5 = input.float(1.44, "Attempt 5 (%)", 0.1, 5.0, 0.01, group = GTR) / 100
r6 = input.float(1.55, "Attempt 6 (%)", 0.1, 5.0, 0.01, group = GTR) / 100

var string GEQL = "Equal Highs / Lows (Liquidity Pools)"
use_eql      = input.bool(true,    "Detect and show EQH / EQL",        group = GEQL)
eql_ref_tf   = input.string("60", "Reference Timeframe (pivots computed here, not the chart's)", options = ["60", "240", "D", "W", "M"], group = GEQL, tooltip = "EQH/EQL pivots are computed on THIS fixed timeframe via request.security, regardless of what timeframe the chart itself is showing — that's what makes the same equal-highs/lows zone appear identically whether you're on a 1m chart or a Daily one. Restricted to 1H and above: POI zones are decided on higher timeframes only, never on the chart's own low-timeframe noise.")
eql_tol      = input.float(0.0005, "Tolerance (price)",  0.00005, 0.002, 0.00001, group = GEQL, tooltip = "How close two swing points need to be to count as \"equal\" — real equal-highs/lows are rarely the exact same pip, since stops cluster around a level rather than stacking on one price.")
eql_lookback = input.int(5,        "History depth (# pivots)", 2, 20,   group = GEQL)

// Simplified on purpose: short labels here, full explanation in the tooltip
// (hover the ⓘ) instead of long inline text.
var string GVIS = "Visuals"

show_levels  = input.bool(true, "POI Lines",   group = GVIS, inline = "show1")
show_sweep   = input.bool(true, "Sweep Marks", group = GVIS, inline = "show2")
show_checklist = input.bool(true, "Setup Checklist", group = GVIS, inline = "show2")
show_info_tbl  = input.bool(false, "Info Table",  group = GVIS, inline = "show3")
show_stats_tbl = input.bool(false, "Stats Table", group = GVIS, inline = "show3")
show_vol_cell  = input.bool(true, "Volatility row in the setup panel", group = GVIS, inline = "show4")
vol_symbol_override = input.string("", "Volatility symbol (blank = auto)", group = GVIS,
     tooltip = "Blank: EUR pairs -> CBOE:EVZ (euro currency volatility), QQQ/NQ -> CBOE:VXN, SPY/ES -> CBOE:VIX, DIA/YM -> CBOE:VXD, IWM/RTY -> CBOE:RVX, gold -> CBOE:GVZ, oil -> CBOE:OVX. Any other symbol (or a ticker TradingView does not have) shows the symbol's own daily ATR(14) as % of price. Type any ticker here to override, e.g. CBOE:VXN.")

poi_line_col    = input.color(color.white, "POI Line Color", group = GVIS,
     tooltip = "One flat color for every POI line (PDH/PDL, PWH/PWL, Asia, EQH/EQL) — always solid, straight. The active swept level still turns green while its trade cycle is live.")
imb_line_col    = input.color(color.white, "Imbalance Color", group = GVIS, inline = "imbcol",
     tooltip = "One flat color for every imbalance line (HTF and chart-native). The line uses the transparency below; its label text is always fully solid.")
imb_line_transp = input.int(10, "Transp %", 0, 90, group = GVIS, inline = "imbcol")

vis_mode     = input.string("Auto (ADR)", "Visibility Mode", options = ["Auto (ADR)", "Manual %"], group = GVIS,
     tooltip = "Auto: a zone shows only within a % of the average daily range of the last closed days, so quiet markets show fewer lines and fast markets more — no daily tuning. Manual: fixed % of price below.")
vis_adr_pct  = input.float(50.0, "Auto: % of ADR", 10.0, 300.0, 5.0, group = GVIS, inline = "adr")
vis_adr_len  = input.int(5, "ADR Days", 1, 30, group = GVIS, inline = "adr")
vis_max_side = input.int(2, "Max Lines Above / Below Price", 1, 10, group = GVIS,
     tooltip = "After merging, only this many nearest live lines are drawn above price and the same below. Levels swept this session always show.")
vis_dist_pct   = input.float(0.25, "Manual: Visibility Distance (% of price)", 0.05, 2.0, 0.01, group = GVIS,
     tooltip = "Used only in Manual mode: a zone shows only while price is within this % of price from it.")
merge_tol   = input.float(0.0005, "Zone Merge Tolerance", 0.00010, 0.005, 0.00010, group = GVIS,
     tooltip = "Zones within this price distance of each other collapse into one line, names joined with \"·\".")
lbl_off_bars = input.int(3, "Labels: candles right of the last candle", 0, 30, group = GVIS,
     tooltip = "Labels of live lines sit this many candles to the right of the last candle, in the chart's right margin, instead of on top of price. Names are just the source: 1H / 4H / D / W / MN for imbalances, PDH / PDL / PWH / PWL / EQH / EQL for levels.")

age_1h_d = input.int(14, "Max age 1H imbalances (days, 0 = no limit)", 0, 3650, group = GVIS,
     tooltip = "Older untouched zones are not drawn, identically on every timeframe. D / W / MN imbalances have no limit.")
age_4h_d = input.int(45, "Max age 4H imbalances (days, 0 = no limit)", 0, 3650, group = GVIS)
age_eq_d = input.int(14, "Max age EQH / EQL (days, 0 = no limit)", 0, 3650, group = GVIS)

show_zone_dbg = input.bool(false, "Zone diagnostic panel (bottom-left)", group = GVIS,
     tooltip = "Counts per zone type: tracked / within visibility distance / too old, plus PDH-PDL state. For comparing timeframes.")

// Zone origin (open time of its candle) still young enough to draw.
f_age_ok(int org, int days) =>
    days == 0 or na(org) or time - org <= days * 86400000

var string GALR = "Proximity Alerts"
use_near_alert       = input.bool(true, "Alert when price nears a POI zone", group = GALR)
near_alert_pct       = input.float(0.20, "Create Alert at Distance (% of price) — forex baseline; auto x2 on futures", 0.02, 2.0, 0.01, group = GALR)
near_alert_reset_pct = input.float(1.00, "Remove Alert Beyond Distance (% of price)", 0.10, 5.0, 0.10, group = GALR)
use_sweep_alert      = input.bool(true, "Alert the instant a POI zone is liquidated (price crosses it)", group = GALR)

// Visibility distance. Auto: % of the average range of the last closed D
// candles ([1] + lookahead_on = closed days only, identical on every chart
// TF). Manual: flat % of current price.
vis_adr      = request.security(syminfo.tickerid, "D", ta.sma(high - low, vis_adr_len)[1], lookahead = barmerge.lookahead_on)
vis_pct_eff  = syminfo.type == "futures" ? vis_dist_pct * 2.0 : vis_dist_pct
max_poi_dist = vis_mode == "Auto (ADR)" and not na(vis_adr) ? vis_adr * vis_adr_pct / 100.0 : close * vis_pct_eff / 100.0


// ---- Volatility reading for the setup panel ----------------------------
// Implied-volatility index matching the open symbol (blank override = auto),
// or, when TradingView has none for it, the symbol's own daily ATR(14) as %
// of price (previous closed day, identical on every chart timeframe).
vol_root = str.upper(syminfo.root)
vol_list_eur = ",6E,EUR,FXE,EUR1,"
vol_list_nq  = ",QQQ,NQ,NDX,US100,NAS100,USTEC,MNQ,QQQM,"
vol_list_spx = ",SPY,ES,SPX,US500,SPX500,MES,VOO,IVV,"
vol_list_dow = ",DIA,YM,DJI,US30,MYM,"
vol_list_rut = ",IWM,RTY,RUT,M2K,US2000,"
vol_list_gld = ",GLD,GC,XAUUSD,MGC,IAU,"
vol_list_oil = ",USO,CL,USOIL,WTI,MCL,"
vol_key = "," + vol_root + ","
vol_auto_sym = syminfo.type == "forex" and (syminfo.basecurrency == "EUR" or syminfo.currency == "EUR") ? "CBOE:EVZ" : str.contains(vol_list_eur, vol_key) ? "CBOE:EVZ" : str.contains(vol_list_nq, vol_key) ? "CBOE:VXN" : str.contains(vol_list_spx, vol_key) ? "CBOE:VIX" : str.contains(vol_list_dow, vol_key) ? "CBOE:VXD" : str.contains(vol_list_rut, vol_key) ? "CBOE:RVX" : str.contains(vol_list_gld, vol_key) ? "CBOE:GVZ" : str.contains(vol_list_oil, vol_key) ? "CBOE:OVX" : ""
vol_sym  = vol_symbol_override != "" ? vol_symbol_override : vol_auto_sym
vol_name = str.contains(vol_sym, ":") ? str.substring(vol_sym, str.pos(vol_sym, ":") + 1) : vol_sym
vol_idx  = vol_sym != "" and show_vol_cell ? request.security(vol_sym, "D", close, ignore_invalid_symbol = true) : na
vol_atr_pct = show_vol_cell ? request.security(syminfo.tickerid, "D", (ta.atr(14) / close * 100.0)[1], lookahead = barmerge.lookahead_on) : na
vol_txt = not show_vol_cell ? "" : not na(vol_idx) ? vol_name + " " + str.tostring(vol_idx, "#.0") + "% (±" + str.tostring(vol_idx / 15.8745, "#.00") + "%/d)" : not na(vol_atr_pct) ? "ATR-D " + str.tostring(vol_atr_pct, "#.00") + "%" : "N/D"

near_pct_eff       = syminfo.type == "futures" ? near_alert_pct * 2.0 : near_alert_pct
near_dist          = close * near_pct_eff / 100.0
near_reset_pct_eff = syminfo.type == "futures" ? near_alert_reset_pct * 2.0 : near_alert_reset_pct
near_reset_dist    = close * near_reset_pct_eff / 100.0

// Imbalances now reuse max_poi_dist directly instead of a separate
// imb_max_pct — they used to have their own 1% threshold that quietly
// drifted from the POI one (0.4%), which is exactly why imbalances weren't
// respecting the same visible-distance limit as POI lines. One input, one
// distance, applied identically to both.
imb_dist = max_poi_dist



// NOTE ON VIEWPORT-BASED HIDING (removed, again): chart.left_visible_bar_time
// is the only way Pine can know the actual visible range, but referencing it
// forces a full script recalculation on every pan/zoom/timeframe change —
// the multi-second redraw lag the user explicitly asked to get rid of.
// Distance-based hiding is a flat % of price (vis_dist_pct / max_poi_dist
// above), default 0.25%, per explicit user requirement.

// =============================================================
// HTF BIAS  (no-repainting)
// =============================================================

// =============================================================
// FIXED-TIMEFRAME CANDLE FEED
// =============================================================
// Every POI source (1H/4H/D/W/M imbalances, PDH/PDL, PWH/PWL) is built from
// its OWN timeframe's candles, never from the chart's bars, so the zones are
// identical whatever timeframe the chart is on. Two paths, picked by
// comparing the chart timeframe with the source's:
//  - chart TF <= source TF: the chart's bars are aggregated into source
//    candles on the source period boundary (time(tf) changes). Chart bars
//    nest exactly inside source candles, so the result is the real candle,
//    delivered at the instant it closes, on every timeframe.
//  - chart TF  > source TF: one chart bar holds several source candles;
//    request.security_lower_tf returns ALL of them and they are fed in
//    order. Plain request.security returns only the LAST one per chart bar,
//    which is what used to build "1H gaps" on a 4H chart out of candles
//    4 hours apart (real gaps missed, fake ones invented).
// The strategy runs on the live bar only when it CLOSES (calc_on_every_tick is
// off), so on load the last executed bar is the last CONFIRMED history bar,
// where barstate.islast is false. Anything drawn "on the last bar" must use
// this instead, or it would not appear until the current bar closes (a minute
// on 1m, an hour/day on higher timeframes).
render_bar = barstate.islast or barstate.islastconfirmedhistory
// Orders only at the bar's close (historical bars are always "confirmed").
order_bar  = barstate.isconfirmed or not barstate.isrealtime

chart_sec = timeframe.in_seconds(timeframe.period)
hi_60  = chart_sec > 3600
hi_240 = chart_sec > 14400
hi_D   = chart_sec > 86400
hi_W   = chart_sec > 604800
hi_15  = chart_sec > 900

[lt60,  lc60,  lh60,  ll60]  = request.security_lower_tf(syminfo.tickerid, hi_60  ? "60"  : timeframe.period, [time, time_close, high, low])
[lt240, lc240, lh240, ll240] = request.security_lower_tf(syminfo.tickerid, hi_240 ? "240" : timeframe.period, [time, time_close, high, low])
[ltD,   lcD,   lhD,   llD]   = request.security_lower_tf(syminfo.tickerid, hi_D   ? "D"   : timeframe.period, [time, time_close, high, low])
[ltW,   lcW,   lhW,   llW]   = request.security_lower_tf(syminfo.tickerid, hi_W   ? "W"   : timeframe.period, [time, time_close, high, low])

// One common clock for every sweep / mitigation time: 15-minute resolution
// on every chart timeframe. On charts of 15m or less the chart bar itself is
// used (its time floored to the 15-minute slot); above that, the 15m
// intrabars of the chart bar. A level crossed at 10:37 is stamped 10:30 on
// 1m, 1H, 4H and D alike, so its session (and how long its frozen line
// stays) is the same everywhere.
[x15_t, x15_h, x15_l] = request.security_lower_tf(syminfo.tickerid, hi_15 ? "15" : timeframe.period, [time, high, low])

// First 15m-resolution time, at or after `since`, at which price reached
// level e (from below for is_high, from above otherwise). na if not this bar.
f_cross_t(float e, bool is_high, int since) =>
    int res = na
    if not na(e) and not na(since)
        if not hi_15
            if time >= since and (is_high ? high >= e : low <= e)
                res := time - time % 900000
        else
            n = array.size(x15_t)
            if n > 0
                for i = 0 to n - 1
                    ti = array.get(x15_t, i)
                    if ti >= since and (is_high ? array.get(x15_h, i) >= e : array.get(x15_l, i) <= e)
                        res := ti
                        break
    res

// Session key from a timestamp (FX day stamp * 10 + bucket), used for the
// "frozen until the end of the session it was swept in" rule. Buckets: 1 Asia,
// 3 London, 5 New York; time between sessions counts as the NEXT session (the
// gap before London is London, the gap before NY is New York, after NY is
// tomorrow's Asia). Purely clock-based, so the same sweep maps to the same
// session on every chart timeframe.
f_sess_key(int t) =>
    int res = na
    if not na(t)
        hh   = hour(t, "UTC+2")
        mins = hh * 60 + minute(t, "UTC+2")
        d    = year(t, "UTC+2") * 10000 + month(t, "UTC+2") * 100 + dayofmonth(t, "UTC+2")
        asia = kz_asia_open <= kz_asia_close ? (hh >= kz_asia_open and hh < kz_asia_close) : (hh >= kz_asia_open or hh < kz_asia_close)
        // Time between sessions belongs to the NEXT session: a level swept at
        // 13:45 is still "just liquidated" when New York opens and must stay
        // on the chart through that session (it used to vanish at the open,
        // which reads as "nothing was liquidated"). London-gap -> London,
        // NY-gap -> New York, after NY -> tomorrow's Asia.
        b = asia ? 1 : mins < kz_lon_close * 60 ? 3 : mins < kz_ny_close_h * 60 + kz_ny_close_m ? 5 : 6
        if b == 6
            d := year(t + 86400000, "UTC+2") * 10000 + month(t + 86400000, "UTC+2") * 100 + dayofmonth(t + 86400000, "UTC+2")
            b := 1
        res := d * 10 + b
    res

// Current session key, from the real clock on the last bar: a level swept in
// a session that has ENDED is gone, including over a weekend or with the
// market closed (the old "end of the last bar" clock stayed inside Friday's
// last session all weekend, so Friday's swept lines never expired). Realtime
// bars cap it at the bar's own close so Bar Replay still follows the replayed
// clock. History bars draw nothing, their value is irrelevant.
cur_sess_key = f_sess_key(barstate.isrealtime ? math.min(timenow, time_close - 1) : render_bar ? timenow : time)

// Aggregates chart bars into candles of the period p = time(tf). Returns the
// just-completed candle (open time, high, low) and the new period's start
// (= that candle's close) on the first bar of a new period. The very first,
// partially loaded period is never emitted.
f_agg_step(int p, array<float> agg, array<int> aggt) =>
    bool  done = false
    int   ct   = na
    int   cct  = na
    float ch   = na
    float cl   = na
    if not na(p)
        if array.size(aggt) == 0
            array.push(aggt, p)
            array.push(aggt, 0)
            array.push(agg, high)
            array.push(agg, low)
        else if p != array.get(aggt, 0)
            if array.get(aggt, 1) == 1
                done := true
                ct   := array.get(aggt, 0)
                cct  := p
                ch   := array.get(agg, 0)
                cl   := array.get(agg, 1)
            array.set(aggt, 0, p)
            array.set(aggt, 1, 1)
            array.set(agg, 0, high)
            array.set(agg, 1, low)
        else
            array.set(agg, 0, math.max(array.get(agg, 0), high))
            array.set(agg, 1, math.min(array.get(agg, 1), low))
    [done, ct, cct, ch, cl]

// RE10110 fix: a 2000-deep cap meant the outer/is-supply recompute (O(n log
// n), run whenever an array changes and inside the render loop) could still
// be asked to sort/scan 2000 elements x10 arrays every time a candle closed.
// 2000 unmitigated gaps per side was never realistic; these caps are sized
// comfortably above any plausible unmitigated stack depth per timeframe.
htf_gap_cap_1h = 200
htf_gap_cap_4h = 200
htf_gap_cap_d  = 60
htf_gap_cap_w  = 60
htf_gap_cap_m  = 24

// Gaps are no longer discovered from the chart's own bars (see f_ctx_gaps):
// f_feed only keeps the candle buffers that PDH/PDL/PWH/PWL read.
chart_gap_feed = false

// Pushes one closed source candle into its 3-candle rolling buffer and
// records a fair value gap when the 3 candles form one: bear when candle 1's
// low is above candle 3's high, bull the mirror. Near edge = the edge price
// returns to first (candle 3's high for bear, its low for bull). org = the
// middle (impulse) candle's open time — the line's start, identical on every
// chart TF. cre = when the gap came into existence (candle 3's close); only
// price AFTER that can mitigate it. Candles already fed are skipped.
f_feed(int t, int cre_t, float h, float l, array<float> hb, array<float> lb, array<int> tb, array<float> bn, array<float> bf, array<int> bo, array<int> bc, array<float> un, array<float> uf, array<int> uo, array<int> uc, int cap) =>
    int fed = 0
    if not na(t) and not na(h) and (array.size(tb) == 0 or t > array.get(tb, 0))
        fed := 1
        array.unshift(hb, h)
        array.unshift(lb, l)
        array.unshift(tb, t)
        if array.size(hb) > 3
            array.pop(hb)
            array.pop(lb)
            array.pop(tb)
        if chart_gap_feed and array.size(hb) == 3
            hA  = array.get(hb, 0)
            lA  = array.get(lb, 0)
            hC  = array.get(hb, 2)
            lC  = array.get(lb, 2)
            tBm = array.get(tb, 1)
            if lC > hA and (lC - hA) >= htf_fvg_min
                array.push(bn, hA)
                array.push(bf, lC)
                array.push(bo, tBm)
                array.push(bc, cre_t)
                if array.size(bn) > cap
                    array.shift(bn)
                    array.shift(bf)
                    array.shift(bo)
                    array.shift(bc)
            if hC < lA and (lA - hC) >= htf_fvg_min
                array.push(un, lA)
                array.push(uf, hC)
                array.push(uo, tBm)
                array.push(uc, cre_t)
                if array.size(un) > cap
                    array.shift(un)
                    array.shift(uf)
                    array.shift(uo)
                    array.shift(uc)
    fed

// One source, one chart bar: feed whatever source candles closed on it.
// Lower-tf path: only candles that have closed (the last intrabar of the
// realtime chart bar may still be forming; it is fed when the bar confirms).
f_src_step(bool hi, bool ag_done, int ag_t, int ag_cct, float ag_h, float ag_l, array<int> lt, array<int> lc, array<float> lh, array<float> ll, array<float> hb, array<float> lb, array<int> tb, array<float> bn, array<float> bf, array<int> bo, array<int> bc, array<float> un, array<float> uf, array<int> uo, array<int> uc, int cap) =>
    int fed = 0
    if hi
        n = array.size(lt)
        if n > 0
            for i = 0 to n - 1
                if i < n - 1 or barstate.isconfirmed
                    fed += f_feed(array.get(lt, i), array.get(lc, i), array.get(lh, i), array.get(ll, i), hb, lb, tb, bn, bf, bo, bc, un, uf, uo, uc, cap)
    else if ag_done
        fed += f_feed(ag_t, ag_cct, ag_h, ag_l, hb, lb, tb, bn, bf, bo, bc, un, uf, uo, uc, cap)
    fed

// Stacked gaps: several same-TF, same-direction gaps from one leg (ranges
// touching within merge_tol, or formed within leg_ms of each other) are one
// stack, and only its OUTERMOST gap — the last one price would liquidate —
// is a POI.
//
// RE10110 fix: the old version checked "is gap i outer" one at a time with
// a full O(n) scan per call, and both f_gap_cross (per touch) and every
// render loop (per element, unconditionally, every bar) called it inside
// their own loop — an O(n^2) cost paid on every bar for all 10 gap arrays.
// This computes every gap's outer flag in ONE O(n log n) pass (sort
// farthest-from-price-first, then walk inward chaining linked gaps into the
// current stack), so a caller that needs the whole array's flags pays
// n log n once instead of n^2.
f_recompute_outer(array<float> near_arr, array<float> far_arr, array<int> org_arr, bool is_supply, int leg_ms) =>
    n = array.size(near_arr)
    result = array.new_bool(n, true)
    if n > 0
        idx = array.sort_indices(near_arr, is_supply ? order.descending : order.ascending)
        float cur_near = na
        float cur_far  = na
        int   cur_org  = na
        bool  have_cur = false
        for k = 0 to n - 1
            i = array.get(idx, k)
            e = array.get(near_arr, i)
            f = array.get(far_arr, i)
            o = array.get(org_arr, i)
            bool outer = true
            if have_cur
                linked = (is_supply ? cur_near <= f + merge_tol : cur_near >= f - merge_tol) or math.abs(cur_org - o) <= leg_ms
                outer := not linked
            array.set(result, i, outer)
            cur_near := e
            cur_far  := f
            cur_org  := o
            have_cur := true
    result

// Removes every gap price has now reached (after the gap existed), at the
// common 15m clock. Inner gaps of a stack are removed silently; only an
// outermost gap counts as a hit (swept record + sweep arming). Returns the
// farthest such hit's edge, 15m crossing time and origin time.
f_gap_cross(array<float> near_arr, array<float> far_arr, array<int> org_arr, array<int> cre_arr, bool is_supply, int leg_ms) =>
    bool  hit  = false
    float edge = na
    int   xt   = na
    int   xo   = na
    int   n = array.size(near_arr)
    // Native min/max first: on the vast majority of bars price is nowhere
    // near any gap and the per-gap loop is skipped entirely.
    if n > 0 and (is_supply ? high >= array.min(near_arr) : low <= array.max(near_arr))
        hits = array.new_int(0)
        tms  = array.new_int(0)
        for i = 0 to n - 1
            e = array.get(near_arr, i)
            if is_supply ? high >= e : low <= e
                t_hit = f_cross_t(e, is_supply, array.get(cre_arr, i))
                if not na(t_hit)
                    array.push(hits, i)
                    array.push(tms, t_hit)
        nh = array.size(hits)
        if nh > 0
            outer_flags = f_recompute_outer(near_arr, far_arr, org_arr, is_supply, leg_ms)
            for k = 0 to nh - 1
                i = array.get(hits, k)
                e = array.get(near_arr, i)
                if array.get(outer_flags, i)
                    if not hit or (is_supply ? e > edge : e < edge)
                        hit  := true
                        edge := e
                        xt   := array.get(tms, k)
                        xo   := array.get(cre_arr, i)
            // hits are ascending, so removing from the back keeps indices valid
            for k = 0 to nh - 1
                i = array.get(hits, nh - 1 - k)
                array.remove(near_arr, i)
                array.remove(far_arr, i)
                array.remove(org_arr, i)
                array.remove(cre_arr, i)
    [hit, edge, xt, xo]

// Nearest-to-price active entry — used only for the single-line proximity
// alert and its price label.
f_htf_gap_nearest(array<float> near_arr, array<float> far_arr, array<int> org_arr) =>
    float best     = na
    float best_far = na
    int   best_org = na
    int   n = array.size(near_arr)
    if n > 0 and render_bar
        int best_i = 0
        for i = 0 to n - 1
            e = array.get(near_arr, i)
            if na(best) or math.abs(close - e) < math.abs(close - best)
                best   := e
                best_i := i
        best_far := array.get(far_arr, best_i)
        best_org := array.get(org_arr, best_i)
    [best, best_far, best_org]

// Candle buffers (last 3 closed candles, newest first) + aggregation state.
var float[] hb60  = array.new_float(0)
var float[] lb60  = array.new_float(0)
var int[]   tb60  = array.new_int(0)
var float[] hb240 = array.new_float(0)
var float[] lb240 = array.new_float(0)
var int[]   tb240 = array.new_int(0)
var float[] hbD   = array.new_float(0)
var float[] lbD   = array.new_float(0)
var int[]   tbD   = array.new_int(0)
var float[] hbW   = array.new_float(0)
var float[] lbW   = array.new_float(0)
var int[]   tbW   = array.new_int(0)
var float[] hbM   = array.new_float(0)
var float[] lbM   = array.new_float(0)
var int[]   tbM   = array.new_int(0)
var float[] ag60  = array.new_float(0)
var int[]   agt60 = array.new_int(0)
var float[] ag240  = array.new_float(0)
var int[]   agt240 = array.new_int(0)
var float[] agD   = array.new_float(0)
var int[]   agtD  = array.new_int(0)
var float[] agW   = array.new_float(0)
var int[]   agtW  = array.new_int(0)
var float[] agM   = array.new_float(0)
var int[]   agtM  = array.new_int(0)

// Gap lists per timeframe/direction: near edge, far edge, origin time,
// creation time.
var float[] htf_b1h_near_arr = array.new_float(0)
var float[] htf_b1h_far_arr  = array.new_float(0)
var int[]   htf_b1h_org_arr  = array.new_int(0)
var int[]   htf_b1h_cre_arr  = array.new_int(0)
var float[] htf_b4h_near_arr = array.new_float(0)
var float[] htf_b4h_far_arr  = array.new_float(0)
var int[]   htf_b4h_org_arr  = array.new_int(0)
var int[]   htf_b4h_cre_arr  = array.new_int(0)
var float[] htf_bd_near_arr  = array.new_float(0)
var float[] htf_bd_far_arr   = array.new_float(0)
var int[]   htf_bd_org_arr   = array.new_int(0)
var int[]   htf_bd_cre_arr   = array.new_int(0)
var float[] htf_bw_near_arr  = array.new_float(0)
var float[] htf_bw_far_arr   = array.new_float(0)
var int[]   htf_bw_org_arr   = array.new_int(0)
var int[]   htf_bw_cre_arr   = array.new_int(0)
var float[] htf_bm_near_arr  = array.new_float(0)
var float[] htf_bm_far_arr   = array.new_float(0)
var int[]   htf_bm_org_arr   = array.new_int(0)
var int[]   htf_bm_cre_arr   = array.new_int(0)

var float[] htf_u1h_near_arr = array.new_float(0)
var float[] htf_u1h_far_arr  = array.new_float(0)
var int[]   htf_u1h_org_arr  = array.new_int(0)
var int[]   htf_u1h_cre_arr  = array.new_int(0)
var float[] htf_u4h_near_arr = array.new_float(0)
var float[] htf_u4h_far_arr  = array.new_float(0)
var int[]   htf_u4h_org_arr  = array.new_int(0)
var int[]   htf_u4h_cre_arr  = array.new_int(0)
var float[] htf_ud_near_arr  = array.new_float(0)
var float[] htf_ud_far_arr   = array.new_float(0)
var int[]   htf_ud_org_arr   = array.new_int(0)
var int[]   htf_ud_cre_arr   = array.new_int(0)
var float[] htf_uw_near_arr  = array.new_float(0)
var float[] htf_uw_far_arr   = array.new_float(0)
var int[]   htf_uw_org_arr   = array.new_int(0)
var int[]   htf_uw_cre_arr   = array.new_int(0)
var float[] htf_um_near_arr  = array.new_float(0)
var float[] htf_um_far_arr   = array.new_float(0)
var int[]   htf_um_org_arr   = array.new_int(0)
var int[]   htf_um_cre_arr   = array.new_int(0)

// =============================================================
// ZONE DISCOVERY IN EACH ZONE'S OWN TIMEFRAME
// =============================================================
// Every imbalance list is built by request.security on the zone's own
// timeframe (1H on 1H candles, W on weekly candles ...), with that
// timeframe's own history. The chart's loaded history (a few weeks on 1m,
// years on 1H, decades on D) and its bar size no longer decide which zones
// exist, so every chart timeframe receives exactly the same list. On the
// chart, zones are imported once they exist (their 3rd candle has closed)
// and from then on the usual chart-side engine (15m sweep clock, swept
// records, session freeze, sweep arming) handles them unchanged.
//
// Packed result: [n_bear, n_bull, bear near.., far.., org.., cre..,
// bull near.., far.., org.., cre..].
f_ctx_gaps(int cap) =>
    var float[] bn = array.new_float(0)
    var float[] bf = array.new_float(0)
    var float[] bo = array.new_float(0)
    var float[] bc = array.new_float(0)
    var float[] un = array.new_float(0)
    var float[] uf = array.new_float(0)
    var float[] uo = array.new_float(0)
    var float[] uc = array.new_float(0)
    // Touched by this candle (gaps that existed before it) -> gone.
    int i = array.size(bn) - 1
    while i >= 0
        if time >= array.get(bc, i) and high >= array.get(bn, i)
            array.remove(bn, i)
            array.remove(bf, i)
            array.remove(bo, i)
            array.remove(bc, i)
        i -= 1
    i := array.size(un) - 1
    while i >= 0
        if time >= array.get(uc, i) and low <= array.get(un, i)
            array.remove(un, i)
            array.remove(uf, i)
            array.remove(uo, i)
            array.remove(uc, i)
        i -= 1
    // Same 3-candle rule as before: candle 1 = [2], candle 3 = this one.
    if not na(high[2]) and not na(time_close)
        if low[2] > high and (low[2] - high) >= htf_fvg_min
            array.push(bn, high)
            array.push(bf, low[2])
            array.push(bo, time[1])
            array.push(bc, time_close)
            if array.size(bn) > cap
                array.shift(bn)
                array.shift(bf)
                array.shift(bo)
                array.shift(bc)
        if high[2] < low and (low - high[2]) >= htf_fvg_min
            array.push(un, low)
            array.push(uf, high[2])
            array.push(uo, time[1])
            array.push(uc, time_close)
            if array.size(un) > cap
                array.shift(un)
                array.shift(uf)
                array.shift(uo)
                array.shift(uc)
    pk = array.new_float(0)
    array.push(pk, array.size(bn))
    array.push(pk, array.size(un))
    array.concat(pk, bn)
    array.concat(pk, bf)
    array.concat(pk, bo)
    array.concat(pk, bc)
    array.concat(pk, un)
    array.concat(pk, uf)
    array.concat(pk, uo)
    array.concat(pk, uc)
    pk

// Imports the zones of one side that came into existence after `upto` and
// have already closed (cre <= this bar's close: a still-forming HTF candle is
// never imported). Returns the newest creation time imported.
f_ctx_import(array<float> pk, bool bear, array<float> near_arr, array<float> far_arr, array<int> org_arr, array<int> cre_arr, int upto, int cap) =>
    int mx = upto
    if not na(pk)
        if array.size(pk) >= 2
            nb = int(array.get(pk, 0))
            nu = int(array.get(pk, 1))
            n  = bear ? nb : nu
            b  = bear ? 2 : 2 + 4 * nb
            if n > 0 and array.size(pk) >= b + 4 * n
                for k = 0 to n - 1
                    c = int(array.get(pk, b + 3 * n + k))
                    if c > upto and c <= time_close
                        array.push(near_arr, array.get(pk, b + k))
                        array.push(far_arr,  array.get(pk, b + n + k))
                        array.push(org_arr,  int(array.get(pk, b + 2 * n + k)))
                        array.push(cre_arr,  c)
                        mx := math.max(mx, c)
                        if array.size(near_arr) > cap
                            array.shift(near_arr)
                            array.shift(far_arr)
                            array.shift(org_arr)
                            array.shift(cre_arr)
    mx

pk60  = request.security(syminfo.tickerid, "60",  f_ctx_gaps(htf_gap_cap_1h), lookahead = barmerge.lookahead_off)
pk240 = request.security(syminfo.tickerid, "240", f_ctx_gaps(htf_gap_cap_4h), lookahead = barmerge.lookahead_off)
pkD   = request.security(syminfo.tickerid, "D",   f_ctx_gaps(htf_gap_cap_d),  lookahead = barmerge.lookahead_off)
pkW   = request.security(syminfo.tickerid, "W",   f_ctx_gaps(htf_gap_cap_w),  lookahead = barmerge.lookahead_off)
pkM   = request.security(syminfo.tickerid, "M",   f_ctx_gaps(htf_gap_cap_m),  lookahead = barmerge.lookahead_off)

var int up60  = 0
var int up240 = 0
var int upD   = 0
var int upW   = 0
var int upM   = 0
im60b  = f_ctx_import(pk60,  true,  htf_b1h_near_arr, htf_b1h_far_arr, htf_b1h_org_arr, htf_b1h_cre_arr, up60,  htf_gap_cap_1h)
im60u  = f_ctx_import(pk60,  false, htf_u1h_near_arr, htf_u1h_far_arr, htf_u1h_org_arr, htf_u1h_cre_arr, up60,  htf_gap_cap_1h)
up60  := math.max(im60b, im60u)
im240b = f_ctx_import(pk240, true,  htf_b4h_near_arr, htf_b4h_far_arr, htf_b4h_org_arr, htf_b4h_cre_arr, up240, htf_gap_cap_4h)
im240u = f_ctx_import(pk240, false, htf_u4h_near_arr, htf_u4h_far_arr, htf_u4h_org_arr, htf_u4h_cre_arr, up240, htf_gap_cap_4h)
up240 := math.max(im240b, im240u)
imDb   = f_ctx_import(pkD,   true,  htf_bd_near_arr,  htf_bd_far_arr,  htf_bd_org_arr,  htf_bd_cre_arr,  upD,   htf_gap_cap_d)
imDu   = f_ctx_import(pkD,   false, htf_ud_near_arr,  htf_ud_far_arr,  htf_ud_org_arr,  htf_ud_cre_arr,  upD,   htf_gap_cap_d)
upD   := math.max(imDb, imDu)
imWb   = f_ctx_import(pkW,   true,  htf_bw_near_arr,  htf_bw_far_arr,  htf_bw_org_arr,  htf_bw_cre_arr,  upW,   htf_gap_cap_w)
imWu   = f_ctx_import(pkW,   false, htf_uw_near_arr,  htf_uw_far_arr,  htf_uw_org_arr,  htf_uw_cre_arr,  upW,   htf_gap_cap_w)
upW   := math.max(imWb, imWu)
imMb   = f_ctx_import(pkM,   true,  htf_bm_near_arr,  htf_bm_far_arr,  htf_bm_org_arr,  htf_bm_cre_arr,  upM,   htf_gap_cap_m)
imMu   = f_ctx_import(pkM,   false, htf_um_near_arr,  htf_um_far_arr,  htf_um_org_arr,  htf_um_cre_arr,  upM,   htf_gap_cap_m)
upM   := math.max(imMb, imMu)

[a60_done,  a60_t,  a60_ct,  a60_h,  a60_l]  = f_agg_step(time("60"),  ag60,  agt60)
[a240_done, a240_t, a240_ct, a240_h, a240_l] = f_agg_step(time("240"), ag240, agt240)
[aD_done,   aD_t,   aD_ct,   aD_h,   aD_l]   = f_agg_step(time("D"),   agD,   agtD)
[aW_done,   aW_t,   aW_ct,   aW_h,   aW_l]   = f_agg_step(time("W"),   agW,   agtW)
[aM_done,   aM_t,   aM_ct,   aM_h,   aM_l]   = f_agg_step(time("M"),   agM,   agtM)

// Feed first, then mitigation: a gap created on this bar can only be
// mitigated by price after its creation time (f_cross_t's `since`).
fed_60  = f_src_step(hi_60,  a60_done,  a60_t,  a60_ct,  a60_h,  a60_l,  lt60,  lc60,  lh60,  ll60,  hb60,  lb60,  tb60,  htf_b1h_near_arr, htf_b1h_far_arr, htf_b1h_org_arr, htf_b1h_cre_arr, htf_u1h_near_arr, htf_u1h_far_arr, htf_u1h_org_arr, htf_u1h_cre_arr, htf_gap_cap_1h)
fed_240 = f_src_step(hi_240, a240_done, a240_t, a240_ct, a240_h, a240_l, lt240, lc240, lh240, ll240, hb240, lb240, tb240, htf_b4h_near_arr, htf_b4h_far_arr, htf_b4h_org_arr, htf_b4h_cre_arr, htf_u4h_near_arr, htf_u4h_far_arr, htf_u4h_org_arr, htf_u4h_cre_arr, htf_gap_cap_4h)
fed_D   = f_src_step(hi_D,   aD_done,   aD_t,   aD_ct,   aD_h,   aD_l,   ltD,   lcD,   lhD,   llD,   hbD,   lbD,   tbD,   htf_bd_near_arr,  htf_bd_far_arr,  htf_bd_org_arr,  htf_bd_cre_arr,  htf_ud_near_arr,  htf_ud_far_arr,  htf_ud_org_arr,  htf_ud_cre_arr,  htf_gap_cap_d)
fed_W   = f_src_step(hi_W,   aW_done,   aW_t,   aW_ct,   aW_h,   aW_l,   ltW,   lcW,   lhW,   llW,   hbW,   lbW,   tbW,   htf_bw_near_arr,  htf_bw_far_arr,  htf_bw_org_arr,  htf_bw_cre_arr,  htf_uw_near_arr,  htf_uw_far_arr,  htf_uw_org_arr,  htf_uw_cre_arr,  htf_gap_cap_w)
fed_M   = f_src_step(false,  aM_done,   aM_t,   aM_ct,   aM_h,   aM_l,   ltW,   lcW,   lhW,   llW,   hbM,   lbM,   tbM,   htf_bm_near_arr,  htf_bm_far_arr,  htf_bm_org_arr,  htf_bm_cre_arr,  htf_um_near_arr,  htf_um_far_arr,  htf_um_org_arr,  htf_um_cre_arr,  htf_gap_cap_m)

[touch_b1h, touch_b1h_edge, xt_b1h, xo_b1h] = f_gap_cross(htf_b1h_near_arr, htf_b1h_far_arr, htf_b1h_org_arr, htf_b1h_cre_arr, true, 3 * 3600000)
[touch_b4h, touch_b4h_edge, xt_b4h, xo_b4h] = f_gap_cross(htf_b4h_near_arr, htf_b4h_far_arr, htf_b4h_org_arr, htf_b4h_cre_arr, true, 3 * 14400000)
[touch_bd,  touch_bd_edge,  xt_bd,  xo_bd]  = f_gap_cross(htf_bd_near_arr,  htf_bd_far_arr,  htf_bd_org_arr,  htf_bd_cre_arr,  true, 4 * 86400000)
[touch_bw,  touch_bw_edge,  xt_bw,  xo_bw]  = f_gap_cross(htf_bw_near_arr,  htf_bw_far_arr,  htf_bw_org_arr,  htf_bw_cre_arr,  true, 3 * 604800000)
[touch_bm,  touch_bm_edge,  xt_bm,  xo_bm]  = f_gap_cross(htf_bm_near_arr,  htf_bm_far_arr,  htf_bm_org_arr,  htf_bm_cre_arr,  true, 3 * 2678400000)
[touch_u1h, touch_u1h_edge, xt_u1h, xo_u1h] = f_gap_cross(htf_u1h_near_arr, htf_u1h_far_arr, htf_u1h_org_arr, htf_u1h_cre_arr, false, 3 * 3600000)
[touch_u4h, touch_u4h_edge, xt_u4h, xo_u4h] = f_gap_cross(htf_u4h_near_arr, htf_u4h_far_arr, htf_u4h_org_arr, htf_u4h_cre_arr, false, 3 * 14400000)
[touch_ud,  touch_ud_edge,  xt_ud,  xo_ud]  = f_gap_cross(htf_ud_near_arr,  htf_ud_far_arr,  htf_ud_org_arr,  htf_ud_cre_arr,  false, 4 * 86400000)
[touch_uw,  touch_uw_edge,  xt_uw,  xo_uw]  = f_gap_cross(htf_uw_near_arr,  htf_uw_far_arr,  htf_uw_org_arr,  htf_uw_cre_arr,  false, 3 * 604800000)
[touch_um,  touch_um_edge,  xt_um,  xo_um]  = f_gap_cross(htf_um_near_arr,  htf_um_far_arr,  htf_um_org_arr,  htf_um_cre_arr,  false, 3 * 2678400000)

// Swept record per timeframe/direction: the most recently mitigated gap,
// kept frozen (origin -> crossing time) until the session it was mitigated
// in ends. Crossing time and session come from the common 15m clock.
var float htf_b1h_swept_px = na
var int   htf_b1h_swept_t  = na
var int   htf_b1h_swept_s  = na
var int   htf_b1h_swept_o  = na
var float htf_b4h_swept_px = na
var int   htf_b4h_swept_t  = na
var int   htf_b4h_swept_s  = na
var int   htf_b4h_swept_o  = na
var float htf_bd_swept_px  = na
var int   htf_bd_swept_t   = na
var int   htf_bd_swept_s   = na
var int   htf_bd_swept_o   = na
var float htf_bw_swept_px  = na
var int   htf_bw_swept_t   = na
var int   htf_bw_swept_s   = na
var int   htf_bw_swept_o   = na
var float htf_bm_swept_px  = na
var int   htf_bm_swept_t   = na
var int   htf_bm_swept_s   = na
var int   htf_bm_swept_o   = na
var float htf_u1h_swept_px = na
var int   htf_u1h_swept_t  = na
var int   htf_u1h_swept_s  = na
var int   htf_u1h_swept_o  = na
var float htf_u4h_swept_px = na
var int   htf_u4h_swept_t  = na
var int   htf_u4h_swept_s  = na
var int   htf_u4h_swept_o  = na
var float htf_ud_swept_px  = na
var int   htf_ud_swept_t   = na
var int   htf_ud_swept_s   = na
var int   htf_ud_swept_o   = na
var float htf_uw_swept_px  = na
var int   htf_uw_swept_t   = na
var int   htf_uw_swept_s   = na
var int   htf_uw_swept_o   = na
var float htf_um_swept_px  = na
var int   htf_um_swept_t   = na
var int   htf_um_swept_s   = na
var int   htf_um_swept_o   = na
if touch_b1h
    htf_b1h_swept_px := touch_b1h_edge
    htf_b1h_swept_t  := xt_b1h
    htf_b1h_swept_s  := f_sess_key(xt_b1h)
    htf_b1h_swept_o  := xo_b1h
if touch_b4h
    htf_b4h_swept_px := touch_b4h_edge
    htf_b4h_swept_t  := xt_b4h
    htf_b4h_swept_s  := f_sess_key(xt_b4h)
    htf_b4h_swept_o  := xo_b4h
if touch_bd
    htf_bd_swept_px := touch_bd_edge
    htf_bd_swept_t  := xt_bd
    htf_bd_swept_s  := f_sess_key(xt_bd)
    htf_bd_swept_o  := xo_bd
if touch_bw
    htf_bw_swept_px := touch_bw_edge
    htf_bw_swept_t  := xt_bw
    htf_bw_swept_s  := f_sess_key(xt_bw)
    htf_bw_swept_o  := xo_bw
if touch_bm
    htf_bm_swept_px := touch_bm_edge
    htf_bm_swept_t  := xt_bm
    htf_bm_swept_s  := f_sess_key(xt_bm)
    htf_bm_swept_o  := xo_bm
if touch_u1h
    htf_u1h_swept_px := touch_u1h_edge
    htf_u1h_swept_t  := xt_u1h
    htf_u1h_swept_s  := f_sess_key(xt_u1h)
    htf_u1h_swept_o  := xo_u1h
if touch_u4h
    htf_u4h_swept_px := touch_u4h_edge
    htf_u4h_swept_t  := xt_u4h
    htf_u4h_swept_s  := f_sess_key(xt_u4h)
    htf_u4h_swept_o  := xo_u4h
if touch_ud
    htf_ud_swept_px := touch_ud_edge
    htf_ud_swept_t  := xt_ud
    htf_ud_swept_s  := f_sess_key(xt_ud)
    htf_ud_swept_o  := xo_ud
if touch_uw
    htf_uw_swept_px := touch_uw_edge
    htf_uw_swept_t  := xt_uw
    htf_uw_swept_s  := f_sess_key(xt_uw)
    htf_uw_swept_o  := xo_uw
if touch_um
    htf_um_swept_px := touch_um_edge
    htf_um_swept_t  := xt_um
    htf_um_swept_s  := f_sess_key(xt_um)
    htf_um_swept_o  := xo_um

// Any active HTF imbalance (1H/4H/D/W/M, gated by its own use_htf_* toggle)
// just got manipulated (price entered it) THIS bar — same-bar OR across all
// tracked timeframes. Feeds hs_imb/ls_imb below, which arms the state
// machine exactly like a liquidity sweep: touch now, wait for the
// structural break (MSS) before entering, same as every other POI.
touch_bear_htf = (use_htf_1h and touch_b1h) or (use_htf_4h and touch_b4h) or (use_htf_d and touch_bd) or (use_htf_w and touch_bw) or (use_htf_m and touch_bm)
touch_bull_htf = (use_htf_1h and touch_u1h) or (use_htf_4h and touch_u4h) or (use_htf_d and touch_ud) or (use_htf_w and touch_uw) or (use_htf_m and touch_um)
touch_bear_htf_edge = touch_b1h ? touch_b1h_edge : touch_b4h ? touch_b4h_edge : touch_bd ? touch_bd_edge : touch_bw ? touch_bw_edge : touch_bm_edge
touch_bull_htf_edge = touch_u1h ? touch_u1h_edge : touch_u4h ? touch_u4h_edge : touch_ud ? touch_ud_edge : touch_uw ? touch_uw_edge : touch_um_edge

htf_bear_1h_ok = array.size(htf_b1h_near_arr) > 0
htf_bear_4h_ok = array.size(htf_b4h_near_arr) > 0
htf_bear_d_ok  = array.size(htf_bd_near_arr)  > 0
htf_bear_w_ok  = array.size(htf_bw_near_arr)  > 0
htf_bear_m_ok  = array.size(htf_bm_near_arr)  > 0
htf_bull_1h_ok = array.size(htf_u1h_near_arr) > 0
htf_bull_4h_ok = array.size(htf_u4h_near_arr) > 0
htf_bull_d_ok  = array.size(htf_ud_near_arr)  > 0
htf_bull_w_ok  = array.size(htf_uw_near_arr)  > 0
htf_bull_m_ok  = array.size(htf_um_near_arr)  > 0

// Nearest-to-price entry per TF — only for the proximity-alert price label
// (alerts stay one-per-TF; detection/reinforcement/display use every entry).
[htf_b1h_edge, htf_b1h_far, htf_b1h_org] = f_htf_gap_nearest(htf_b1h_near_arr, htf_b1h_far_arr, htf_b1h_org_arr)
[htf_b4h_edge, htf_b4h_far, htf_b4h_org] = f_htf_gap_nearest(htf_b4h_near_arr, htf_b4h_far_arr, htf_b4h_org_arr)
[htf_bd_edge,  htf_bd_far,  htf_bd_org]  = f_htf_gap_nearest(htf_bd_near_arr,  htf_bd_far_arr,  htf_bd_org_arr)
[htf_bw_edge,  htf_bw_far,  htf_bw_org]  = f_htf_gap_nearest(htf_bw_near_arr,  htf_bw_far_arr,  htf_bw_org_arr)
[htf_bm_edge,  htf_bm_far,  htf_bm_org]  = f_htf_gap_nearest(htf_bm_near_arr,  htf_bm_far_arr,  htf_bm_org_arr)
[htf_u1h_edge, htf_u1h_far, htf_u1h_org] = f_htf_gap_nearest(htf_u1h_near_arr, htf_u1h_far_arr, htf_u1h_org_arr)
[htf_u4h_edge, htf_u4h_far, htf_u4h_org] = f_htf_gap_nearest(htf_u4h_near_arr, htf_u4h_far_arr, htf_u4h_org_arr)
[htf_ud_edge,  htf_ud_far,  htf_ud_org]  = f_htf_gap_nearest(htf_ud_near_arr,  htf_ud_far_arr,  htf_ud_org_arr)
[htf_uw_edge,  htf_uw_far,  htf_uw_org]  = f_htf_gap_nearest(htf_uw_near_arr,  htf_uw_far_arr,  htf_uw_org_arr)
[htf_um_edge,  htf_um_far,  htf_um_org]  = f_htf_gap_nearest(htf_um_near_arr,  htf_um_far_arr,  htf_um_org_arr)

htf_bear = (use_htf_1h and htf_bear_1h_ok) or (use_htf_4h and htf_bear_4h_ok) or (use_htf_d and htf_bear_d_ok) or (use_htf_w and htf_bear_w_ok) or (use_htf_m and htf_bear_m_ok)
htf_bull = (use_htf_1h and htf_bull_1h_ok) or (use_htf_4h and htf_bull_4h_ok) or (use_htf_d and htf_bull_d_ok) or (use_htf_w and htf_bull_w_ok) or (use_htf_m and htf_bull_m_ok)

// =============================================================
// SESSION / KILL ZONE
// =============================================================

// Kept the h_utc/m_utc names to avoid touching every call site, but these
// are now UTC+2 hours/minutes (matches the Market Sessions inputs above).
h_utc = hour(time, "UTC+2")
m_utc = minute(time, "UTC+2")

// Session windows (Asia/London/NY) are an intraday concept: hour(time, ...)
// only means anything when the chart's own bar can actually move across
// hours within a day. On a Daily (or Weekly/Monthly) chart every bar's time
// is that period's fixed start, so hour() returns the SAME constant on
// every single bar — the window it happens to fall in (Asia by default,
// 00:00) evaluates true FOREVER, never once flipping false. That silently
// broke everything downstream that depends on a true->false transition: the
// session box never re-opens (one box object keeps stretching, unbounded,
// to the running all-time high/low of the whole loaded history) and price's
// auto-scale gets dragged along with it, squashing real candles and nearby
// POI lines into a visual smear. Gating in_asia/in_london/in_ny to false on
// D/W/M+ makes the whole session subsystem (box drawing, live H/L tracking,
// the sweep sources already restricted to the 1-minute exec timeframe) a
// clean no-op there instead — correct, since a daily bar has no intraday
// granularity to derive a session extreme from anyway.
is_intraday_tf = timeframe.in_seconds(timeframe.period) < 86400

ny_closed = h_utc > kz_ny_close_h or (h_utc == kz_ny_close_h and m_utc >= kz_ny_close_m)
in_london = is_intraday_tf and h_utc >= kz_lon_open and h_utc < kz_lon_close
in_ny     = is_intraday_tf and h_utc >= kz_ny_open and not ny_closed
in_kz     = in_london or in_ny

// Handles both an overnight session (e.g. 22h-7h, wraps past midnight) and
// a same-day session (e.g. 1h-6h) depending on which input is larger.
in_asia = is_intraday_tf and (kz_asia_open <= kz_asia_close ? (h_utc >= kz_asia_open and h_utc < kz_asia_close) : (h_utc >= kz_asia_open or h_utc < kz_asia_close))


// Running high/low while each kill zone session is in progress — used only
// to draw the session range boxes. Session highs/lows are NOT POI anymore:
// they were built from the chart's own bars (on a 4H chart "Asia H" covered
// 03:00-11:00 and London never existed), so they could never look the same
// on every timeframe.
var float lon_live_h = na
var float lon_live_l = na
if in_london
    lon_live_h := na(lon_live_h) ? high : math.max(lon_live_h, high)
    lon_live_l := na(lon_live_l) ? low  : math.min(lon_live_l, low)
else if in_london[1]
    lon_live_h := na
    lon_live_l := na

var float ny_live_h = na
var float ny_live_l = na
if in_ny
    ny_live_h := na(ny_live_h) ? high : math.max(ny_live_h, high)
    ny_live_l := na(ny_live_l) ? low  : math.min(ny_live_l, low)
else if in_ny[1]
    ny_live_h := na
    ny_live_l := na

// =============================================================
// DAILY + PER-SESSION TRADE COUNTERS
// =============================================================

var int trades_today = 0
var int last_day_id  = 0

day_id = year(time) * 10000 + month(time) * 100 + dayofmonth(time)
if day_id != last_day_id
    trades_today := 0
    last_day_id  := day_id

// can_trade: used for SWEEP DETECTION only (state-machine engaging, lines
// turning green, checklist appearing) — deliberately session-agnostic so a
// sweep outside London/NY still gets tracked instead of silently vanishing.
can_trade = trades_today < max_day_tr and strategy.position_size == 0

// Trading only actually happens in London/NY, capped independently per
// session (sess_max_trades each, default 2) — this is the hard rule the
// user asked for. Counters reset the moment each session starts.
var int lon_session_trades = 0
var int ny_session_trades  = 0

if in_london and not in_london[1]
    lon_session_trades := 0
if in_ny and not in_ny[1]
    ny_session_trades := 0

can_trade_entry = can_trade and ((in_london and lon_session_trades < sess_max_trades) or (in_ny and ny_session_trades < sess_max_trades))

// =============================================================
// PREVIOUS DAY / WEEK HIGH & LOW — from the fixed D / W candle feed
// =============================================================
// The previous closed D (W) candle, exactly as fed above: same value, same
// line start (the candle's open) and same moment of refresh on every chart
// timeframe. `*_since` = when the candle closed; only price after that can
// sweep the level.
is_new_day  = fed_D > 0
is_new_week = fed_W > 0

var float pdh       = na
var float pdl       = na
var int   pdh_bar   = na
var int   pdl_bar   = na
var int   pdhl_since = na
var float pwh       = na
var float pwl       = na
var int   pwh_bar   = na
var int   pwl_bar   = na
var int   pwhl_since = na

if is_new_day and array.size(hbD) > 0
    pdh        := array.get(hbD, 0)
    pdl        := array.get(lbD, 0)
    pdh_bar    := array.get(tbD, 0)
    pdl_bar    := array.get(tbD, 0)
    pdhl_since := array.get(tbD, 0) + 86400000
if is_new_week and array.size(hbW) > 0
    pwh        := array.get(hbW, 0)
    pwl        := array.get(lbW, 0)
    pwh_bar    := array.get(tbW, 0)
    pwl_bar    := array.get(tbW, 0)
    pwhl_since := array.get(tbW, 0) + 7 * 86400000

var float asia_live_h = na
var float asia_live_l = na
if in_asia
    asia_live_h := na(asia_live_h) ? high : math.max(asia_live_h, high)
    asia_live_l := na(asia_live_l) ? low  : math.min(asia_live_l, low)
else if in_asia[1]
    asia_live_h := na
    asia_live_l := na

// =============================================================
// EQUAL HIGHS / LOWS
// =============================================================
// Pivots for EQH/EQL come from the fixed eql_ref_tf candles (default 1H),
// NOT from the chart's bars, fed through exactly the same two paths as the
// imbalance engine above (aggregate chart bars when chart TF <= ref TF, all
// ref candles via request.security_lower_tf when the chart is higher). The
// old single request.security fetch returned one ref candle per chart bar on
// a 4H/D chart, so the pivots were computed on a series of candles hours
// apart and EQH/EQL differed from the 1H/1m view.
eql_sec = timeframe.in_seconds(eql_ref_tf)
hi_eql  = chart_sec > eql_sec
[lte, lce, lhe, lle] = request.security_lower_tf(syminfo.tickerid, hi_eql ? eql_ref_tf : timeframe.period, [time, time_close, high, low])
var float[] age  = array.new_float(0)
var int[]   agte = array.new_int(0)
[ae_done, ae_t, ae_ct, ae_h, ae_l] = f_agg_step(time(eql_ref_tf), age, agte)

var float[] eql_h_buf = array.new_float(0)
var float[] eql_l_buf = array.new_float(0)
var int[]   eql_t_buf = array.new_int(0)
eql_buf_cap = sw_len * 2 + 5

f_eql_pivot(array<float> vbuf, array<int> tbuf, int len, bool is_high) =>
    float res   = na
    int   res_t = na
    n = array.size(vbuf)
    if n >= 2 * len + 1
        c  = n - 1 - len
        cv = array.get(vbuf, c)
        bool ok = true
        for i = 1 to len
            v_before = array.get(vbuf, c - i)
            v_after  = array.get(vbuf, c + i)
            if is_high ? (v_before >= cv or v_after >= cv) : (v_before <= cv or v_after <= cv)
                ok := false
        if ok
            res   := cv
            res_t := array.get(tbuf, c)
    [res, res_t]

var float[] swh_hist = array.new_float(0)
var float[] swl_hist = array.new_float(0)

// Every confirmed equal-high/low is kept in a live list (not a single slot
// that the next unrelated one overwrites) until price actually sweeps it.
// bar = the pivot candle's open (line start), cre = the moment it was
// confirmed (only price after that can sweep it).
var float[] eqh_arr     = array.new_float(0)
var int[]   eqh_bar_arr = array.new_int(0)
var int[]   eqh_cre_arr = array.new_int(0)
var float[] eql_arr     = array.new_float(0)
var int[]   eql_bar_arr = array.new_int(0)
var int[]   eql_cre_arr = array.new_int(0)

// Push a newly confirmed equal-high/low, deduplicated against any existing
// live entry within eql_tol.
f_eqh_push(array<float> px_arr, array<int> bar_arr, array<int> cre_arr, float px, int bar, int cre, float tol) =>
    bool dup = false
    n = array.size(px_arr)
    if n > 0
        for i = 0 to n - 1
            if math.abs(px - array.get(px_arr, i)) <= tol
                dup := true
    if not dup
        array.push(px_arr, px)
        array.push(bar_arr, bar)
        array.push(cre_arr, cre)
        if array.size(px_arr) > 100
            array.shift(px_arr)
            array.shift(bar_arr)
            array.shift(cre_arr)
    array.size(px_arr)

// One closed reference candle: extend the pivot buffer, confirm a pivot
// sw_len candles back if there is one, and if it matches a recent pivot
// within eql_tol, record the equal-high/low. Returns [new EQH, new EQL].
f_eql_feed(int t, int ct, float h, float l) =>
    bool nh = false
    bool nl = false
    if not na(t) and not na(h) and (array.size(eql_t_buf) == 0 or t > array.get(eql_t_buf, array.size(eql_t_buf) - 1))
        array.push(eql_h_buf, h)
        array.push(eql_l_buf, l)
        array.push(eql_t_buf, t)
        if array.size(eql_h_buf) > eql_buf_cap
            array.shift(eql_h_buf)
            array.shift(eql_l_buf)
            array.shift(eql_t_buf)
        [wh, wht] = f_eql_pivot(eql_h_buf, eql_t_buf, sw_len, true)
        [wl, wlt] = f_eql_pivot(eql_l_buf, eql_t_buf, sw_len, false)
        if use_eql and not na(wh)
            sz = array.size(swh_hist)
            if sz > 0
                for i = 0 to sz - 1
                    if math.abs(wh - array.get(swh_hist, i)) <= eql_tol
                        nh := true
                        f_eqh_push(eqh_arr, eqh_bar_arr, eqh_cre_arr, wh, wht, ct, eql_tol)
                        break
            if array.size(swh_hist) >= eql_lookback
                array.shift(swh_hist)
            array.push(swh_hist, wh)
        if use_eql and not na(wl)
            sz = array.size(swl_hist)
            if sz > 0
                for i = 0 to sz - 1
                    if math.abs(wl - array.get(swl_hist, i)) <= eql_tol
                        nl := true
                        f_eqh_push(eql_arr, eql_bar_arr, eql_cre_arr, wl, wlt, ct, eql_tol)
                        break
            if array.size(swl_hist) >= eql_lookback
                array.shift(swl_hist)
            array.push(swl_hist, wl)
    [nh, nl]

// Removes every equal-high/low price has now reached (after it was
// confirmed), at the common 15m clock. Returns [hit, level, origin, time].
f_eqh_cross(array<float> px_arr, array<int> bar_arr, array<int> cre_arr, bool is_high) =>
    bool  touched     = false
    float touched_px  = na
    int   touched_bar = na
    int   touched_xt  = na
    n = array.size(px_arr)
    if n > 0 and (is_high ? high >= array.min(px_arr) : low <= array.max(px_arr))
        for j = 0 to n - 1
            i = n - 1 - j
            e = array.get(px_arr, i)
            if is_high ? high >= e : low <= e
                t_hit = f_cross_t(e, is_high, array.get(cre_arr, i))
                if not na(t_hit)
                    touched     := true
                    touched_px  := e
                    touched_bar := array.get(bar_arr, i)
                    touched_xt  := t_hit
                    array.remove(px_arr, i)
                    array.remove(bar_arr, i)
                    array.remove(cre_arr, i)
    [touched, touched_px, touched_bar, touched_xt]


// Nearest-to-price live entry — only for the single-line proximity alert.
f_eqh_nearest(array<float> px_arr, array<int> bar_arr) =>
    float best     = na
    int   best_bar = na
    n = array.size(px_arr)
    if n > 0 and render_bar
        for i = 0 to n - 1
            e = array.get(px_arr, i)
            if na(best) or math.abs(close - e) < math.abs(close - best)
                best     := e
                best_bar := array.get(bar_arr, i)
    [best, best_bar]

// EQH/EQL discovered in eql_ref_tf's own context (same rules as
// f_eql_pivot / f_eql_feed / f_eqh_push), so the list does not depend on the
// chart's history either. Packed: [n_eqh, n_eql, h px.., h bar.., h cre..,
// l px.., l bar.., l cre..].
f_ctx_eq() =>
    var float[] hp = array.new_float(0)
    var float[] hb = array.new_float(0)
    var float[] hc = array.new_float(0)
    var float[] lp = array.new_float(0)
    var float[] lb = array.new_float(0)
    var float[] lc = array.new_float(0)
    var float[] swh = array.new_float(0)
    var float[] swl = array.new_float(0)
    int i = array.size(hp) - 1
    while i >= 0
        if time >= array.get(hc, i) and high >= array.get(hp, i)
            array.remove(hp, i)
            array.remove(hb, i)
            array.remove(hc, i)
        i -= 1
    i := array.size(lp) - 1
    while i >= 0
        if time >= array.get(lc, i) and low <= array.get(lp, i)
            array.remove(lp, i)
            array.remove(lb, i)
            array.remove(lc, i)
        i -= 1
    if use_eql and bar_index >= 2 * sw_len and not na(time_close)
        ch = high[sw_len]
        cl = low[sw_len]
        bool okh = true
        bool okl = true
        for k = 1 to sw_len
            if high[sw_len - k] >= ch or high[sw_len + k] >= ch
                okh := false
            if low[sw_len - k] <= cl or low[sw_len + k] <= cl
                okl := false
        if okh
            sz = array.size(swh)
            if sz > 0
                for j = 0 to sz - 1
                    if math.abs(ch - array.get(swh, j)) <= eql_tol
                        bool dup = false
                        nh = array.size(hp)
                        if nh > 0
                            for q = 0 to nh - 1
                                if math.abs(ch - array.get(hp, q)) <= eql_tol
                                    dup := true
                        if not dup
                            array.push(hp, ch)
                            array.push(hb, time[sw_len])
                            array.push(hc, time_close)
                            if array.size(hp) > 100
                                array.shift(hp)
                                array.shift(hb)
                                array.shift(hc)
                        break
            if array.size(swh) >= eql_lookback
                array.shift(swh)
            array.push(swh, ch)
        if okl
            sz = array.size(swl)
            if sz > 0
                for j = 0 to sz - 1
                    if math.abs(cl - array.get(swl, j)) <= eql_tol
                        bool dup = false
                        nl = array.size(lp)
                        if nl > 0
                            for q = 0 to nl - 1
                                if math.abs(cl - array.get(lp, q)) <= eql_tol
                                    dup := true
                        if not dup
                            array.push(lp, cl)
                            array.push(lb, time[sw_len])
                            array.push(lc, time_close)
                            if array.size(lp) > 100
                                array.shift(lp)
                                array.shift(lb)
                                array.shift(lc)
                        break
            if array.size(swl) >= eql_lookback
                array.shift(swl)
            array.push(swl, cl)
    pk = array.new_float(0)
    array.push(pk, array.size(hp))
    array.push(pk, array.size(lp))
    array.concat(pk, hp)
    array.concat(pk, hb)
    array.concat(pk, hc)
    array.concat(pk, lp)
    array.concat(pk, lb)
    array.concat(pk, lc)
    pk

f_eq_import(array<float> pk, bool is_high, array<float> px_arr, array<int> bar_arr, array<int> cre_arr, int upto) =>
    int mx = upto
    if not na(pk)
        if array.size(pk) >= 2
            nh = int(array.get(pk, 0))
            nl = int(array.get(pk, 1))
            n  = is_high ? nh : nl
            b  = is_high ? 2 : 2 + 3 * nh
            if n > 0 and array.size(pk) >= b + 3 * n
                for k = 0 to n - 1
                    c = int(array.get(pk, b + 2 * n + k))
                    if c > upto and c <= time_close
                        array.push(px_arr,  array.get(pk, b + k))
                        array.push(bar_arr, int(array.get(pk, b + n + k)))
                        array.push(cre_arr, c)
                        mx := math.max(mx, c)
                        if array.size(px_arr) > 100
                            array.shift(px_arr)
                            array.shift(bar_arr)
                            array.shift(cre_arr)
    mx

pkEQ = request.security(syminfo.tickerid, eql_ref_tf, f_ctx_eq(), lookahead = barmerge.lookahead_off)
var int upEQ = 0
imEQh = f_eq_import(pkEQ, true,  eqh_arr, eqh_bar_arr, eqh_cre_arr, upEQ)
imEQl = f_eq_import(pkEQ, false, eql_arr, eql_bar_arr, eql_cre_arr, upEQ)
eqh_new = imEQh > upEQ
eql_new = imEQl > upEQ
upEQ := math.max(imEQh, imEQl)

// Feed first, then sweep check (a level confirmed this bar can only be swept
// by price after its confirmation time).
[touch_eqh, touch_eqh_px, touch_eqh_bar, touch_eqh_xt] = f_eqh_cross(eqh_arr, eqh_bar_arr, eqh_cre_arr, true)
[touch_eql, touch_eql_px, touch_eql_bar, touch_eql_xt] = f_eqh_cross(eql_arr, eql_bar_arr, eql_cre_arr, false)


// =============================================================
// CE (CAMBIO ESTRUCTURAL) — the structure level an entry waits for
// =============================================================
// Definition (ICT market structure shift / SMC change of character): once
// liquidity is taken, the CE is the swing that STARTED the final leg into
// that liquidity, and it is confirmed only by a candle CLOSING beyond it —
// a wick through it is another liquidity grab, not a break.
//   Short setup (highs taken): the low the last push up began from.
//   Long setup  (lows taken):  the high the last push down began from.
//
// "Started the final leg" is decided by depth, not by candle count. Walking
// back from the extreme, the running low (short setup) is the candidate; it
// becomes the CE as soon as an older candle stands far enough above it —
// i.e. the counter-move that preceded it was a real pullback:
//     pullback >= max(ce_leg_pct % of the leg that followed, ce_min_atr x ATR14)
// The % term makes it scale-free (a pause inside one push is small relative
// to the push, so it is skipped); the ATR term stops 1-2 candle micro-dips
// from ever qualifying. Every earlier failure mode came from moving the level
// on candle events instead of on this definition:
//   - a pivot confirmed N bars later: late, missed the real swing;
//   - the deepest wick of a fixed window: the bottom of the whole rally;
//   - any post-sweep pivot (the old ratchet): a pullback AFTER the extreme,
//     which is not the swing that created it — the CE sat on a minor
//     internal high/low and fired early.
//
// CLOSE RULE (the user's backtested edge): structure only moves on a CLOSE.
// A new extreme exists only when a candle CLOSES beyond the previous one; a
// wick that pokes beyond it and closes back inside is annulled — it moves
// nothing, and the old extreme stays the level. Applied wherever an extreme
// is tracked below (entry cycle and CE history).
atr_ce = ta.atr(14)

// [level, bar_index, found] of the swing that started the final leg into the
// extreme printed e_off bars ago. short_side: the extreme is a HIGH (short
// setup) and the CE is a low; otherwise the mirror. found = false means no
// pullback qualified inside the lookback and the level is the window's
// deepest point (one straight impulse) — usable as a starting CE, never as
// a relocation. The search starts at the candle BEFORE the extreme: the
// extreme candle's own opposite wick (e.g. the high of the hammer that made
// the low) is part of the reversal, never the start of the leg — using it
// produced one-candle CEs with no visible reason. ONE exception: a
// DISPLACEMENT candle (closes in the push direction with a body of at least
// ce_disp_atr x ATR) that made the extreme is the move itself, so its own
// opposite wick is the start of the leg and counts — otherwise the level
// fell to the previous candle even when the displacement candle had gone
// deeper (green candle dips a little below the red one, then rallies).
// A swing also needs a REAL REACTION: the pullback only counts if at least
// one candle in it closed in the pullback's direction (a bullish candle in
// the bounce that forms a CE high, a bearish one in the dip that forms a CE
// low). A "bounce" made only of the wicks of consecutive bearish candles is
// not structure — it put a CE (and a long) in the middle of a straight drop.
f_ce_ref(bool short_side, int e_off) =>
    float res     = na
    int   res_bar = na
    bool  found   = false
    lim = math.min(ce_scan_bars, 495 - e_off)
    if e_off >= 0 and lim >= 3
        float ext = short_side ? high[e_off] : low[e_off]
        bool  own = (short_side ? close[e_off] > open[e_off] : close[e_off] < open[e_off]) and math.abs(close[e_off] - open[e_off]) >= ce_disp_atr * nz(atr_ce)
        // Displacement candle: its base is the last swing right before it,
        // even when that pause is smaller than a normal pullback (a giant
        // vertical candle preceded by a 1-2 candle pause: the pause IS the
        // origin of the impulse, the depth scan below would skip it).
        if own
            for j = e_off + 1 to e_off + math.min(ce_piv_bars, lim - 1)
                bool piv = short_side ? (low[j] < low[j + 1] and low[j] < low[j - 1]) : (high[j] > high[j + 1] and high[j] > high[j - 1])
                if piv
                    found   := true
                    res     := short_side ? low[j] : high[j]
                    res_bar := bar_index - j
                    break
            // No single-candle swing: the extreme ends a run of consecutive
            // push-direction candles (an impulse). Its origin is the pause
            // candle right before the run (or the first candle of the run if
            // its wick went deeper) — e.g. the one small bounce before a
            // 4-candle drop, which the pullback-depth scan would skip.
            if not found
                int k = e_off + 1
                while k < e_off + lim and (short_side ? close[k] > open[k] : close[k] < open[k])
                    k += 1
                if k - e_off >= ce_run_bars and k < e_off + lim
                    int kk = k
                    if short_side ? low[k - 1] < low[k] : high[k - 1] > high[k]
                        kk := k - 1
                    found   := true
                    res     := short_side ? low[kk] : high[kk]
                    res_bar := bar_index - kk
        if not found
            int   m_i = own ? e_off : e_off + 1
            float m   = short_side ? low[m_i] : high[m_i]
            // rev: a candle closing in the pullback's direction exists between
            // the candle being tested and the running level (inclusive). A push
            // candle used as the start is not a pullback candle.
            bool  rev = own ? false : (short_side ? close[m_i] < open[m_i] : close[m_i] > open[m_i])
            for i = m_i + 1 to e_off + lim
                rev := rev or (short_side ? close[i] < open[i] : close[i] > open[i])
                // The %-of-leg part is capped in ATR: the leg keeps growing while
                // the scan walks back, so on a long rally with shallow pullbacks
                // 25% of it exceeded every real pullback and the CE jumped to the
                // origin of the whole move (the trade CE drawn far below price).
                thr = math.max(ce_min_atr * nz(atr_ce), math.min(math.abs(ext - m) * ce_leg_pct / 100.0, ce_leg_cap_atr * nz(atr_ce)))
                cm  = short_side ? high[i] - m : m - low[i]
                if cm > 0 and cm >= thr and rev
                    found := true
                    // The candle that closes the pullback (e.g. the decline candle
                    // right before the base) is part of the base: its own wick
                    // counts if it went deeper.
                    if short_side ? low[i] < m : high[i] > m
                        m   := short_side ? low[i] : high[i]
                        m_i := i
                    break
                if short_side ? low[i] < m : high[i] > m
                    m   := short_side ? low[i] : high[i]
                    m_i := i
                    rev := short_side ? close[i] < open[i] : close[i] > open[i]
            res     := m
            res_bar := bar_index - m_i
    [res, res_bar, found]


// Depth of the pullback between an extreme (bar since_bar) and now: how far
// price fell from it (want_low) / rose from it, over the candles in between.
// Bounded, and only evaluated on the rare events that need it.
// Returns [depth, bars from the extreme's candle to the bottom of that
// pullback] — the second value is how long the counter-move lasted.
f_pullback_depth(float ext_px, int since_bar, bool want_low) =>
    float depth = 0.0
    int   bot_bars = 0
    n = math.min(bar_index - since_bar - 1, 495)
    if n >= 1
        for k = 1 to n
            d = want_low ? ext_px - low[k] : high[k] - ext_px
            if d >= depth
                depth    := d
                bot_bars := bar_index - k - since_bar
    [depth, bot_bars]

// Is the swing at `level` (printed on level_bar) an ESTABLISHED structure: at
// least ce_cont_bars candles old and separated from now by a pullback of at
// least ce_cont_atr x ATR? rising: the level is a high (pullback = drop).
// Used for two things with one definition:
//   - a wick beyond an established level is a RETEST (annulled: the level
//     stays, only a CLOSE beyond it breaks it);
//   - a wick beyond a level whose swing is still forming (adjacent candle,
//     no real pullback yet) just makes the swing deeper/higher: the LEVEL is
//     the deepest wick, a break still needs a close beyond it.
f_swing_sig(float level, int level_bar, bool rising) =>
    [pb_depth, pb_bars] = f_pullback_depth(level, level_bar, rising)
    bar_index - level_bar >= ce_cont_bars and pb_depth >= ce_cont_atr * nz(atr_ce)

// A continuation CE (a close beyond the last extreme after a pullback) is a
// real structure change only if that extreme is an established swing AND the
// counter-move was a real LEG: at least ce_leg_bars candles from the extreme
// to the bottom of the pullback. One big candle against a trend is not a leg
// — breaking its origin is just the trend making a new high/low.
f_leg_real(float level, int level_bar, bool rising) =>
    [lg_depth, lg_bars] = f_pullback_depth(level, level_bar, rising)
    bar_index - level_bar >= ce_cont_bars and lg_depth >= ce_cont_atr * nz(atr_ce) and lg_bars >= ce_leg_bars

// =============================================================
// TIERED RISK ENGINE
// =============================================================

var int attempt = 1

f_risk(int a) =>
    a == 1 ? r1 : a == 2 ? r2 : a == 3 ? r3 : a == 4 ? r4 : a == 5 ? r5 : r6

was_in_trade = strategy.position_size[1] != 0 and strategy.position_size == 0
if was_in_trade
    n = strategy.closedtrades - 1
    if n >= 0
        last_profit = strategy.closedtrades.profit(n)
        attempt    := last_profit > 0 ? 1 : math.min(attempt + 1, 6)

f_qty(float sl_dist) =>
    sl_dist > 0.0 ? (fixed_cap * f_risk(attempt)) / sl_dist : 0.0

poi_in_rng(float px) =>
    not na(px) and math.abs(close - px) <= max_poi_dist

// =============================================================
// CANDLE DIRECTION
// =============================================================

is_bull = close > open
is_bear = close < open

// =============================================================
// POI LIQUIDATION STATE
// =============================================================
// Lives here, ABOVE the state machine, because the state machine now arms
// off these flags: *_liq is true on the single bar price first crosses the
// level, which is exactly the "zone liquidated" event. Kept together with the
// swept-time/session bookkeeping the POI renderer reads further down.

var bool pdh_swept    = false
var bool pdl_swept    = false
var bool pwh_swept    = false
var bool pwl_swept    = false

// Liquidation time (15m clock) + the session key it happened in. A level
// swept in the CURRENT session stays visible, frozen at the point it was hit;
// once the session changes, it's gone — see f_poi_entry below. Both come
// from the common clock, so they're identical on every chart timeframe.
var int pdh_swept_t = na
var int pdh_swept_s = na
var int pdl_swept_t = na
var int pdl_swept_s = na
var int pwh_swept_t = na
var int pwh_swept_s = na
var int pwl_swept_t = na
var int pwl_swept_s = na
var float eqh_swept_px = na
var int   eqh_swept_t  = na
var int   eqh_swept_s  = na
var int   eqh_swept_o  = na
var float eql_swept_px = na
var int   eql_swept_t  = na
var int   eql_swept_s  = na
var int   eql_swept_o  = na

if is_new_day
    pdh_swept := false
    pdl_swept := false
if is_new_week
    pwh_swept := false
    pwl_swept := false

// Crossing time (na = not swept this bar). Only price after the level's
// candle closed counts (pdhl_since / pwhl_since).
pdh_xt = pdh_swept or na(pdh) ? na : f_cross_t(pdh, true,  pdhl_since)
pdl_xt = pdl_swept or na(pdl) ? na : f_cross_t(pdl, false, pdhl_since)
pwh_xt = pwh_swept or na(pwh) ? na : f_cross_t(pwh, true,  pwhl_since)
pwl_xt = pwl_swept or na(pwl) ? na : f_cross_t(pwl, false, pwhl_since)

pdh_liq    = not na(pdh_xt)
pdl_liq    = not na(pdl_xt)
pwh_liq    = not na(pwh_xt)
pwl_liq    = not na(pwl_xt)
// Equal highs/lows: any still-live entry swept this bar (f_eqh_cross above).
eqh_liq    = touch_eqh
eql_liq    = touch_eql

if pdh_liq
    pdh_swept   := true
    pdh_swept_t := pdh_xt
    pdh_swept_s := f_sess_key(pdh_xt)
if pdl_liq
    pdl_swept   := true
    pdl_swept_t := pdl_xt
    pdl_swept_s := f_sess_key(pdl_xt)
if pwh_liq
    pwh_swept   := true
    pwh_swept_t := pwh_xt
    pwh_swept_s := f_sess_key(pwh_xt)
if pwl_liq
    pwl_swept   := true
    pwl_swept_t := pwl_xt
    pwl_swept_s := f_sess_key(pwl_xt)
if eqh_liq
    eqh_swept_px := touch_eqh_px
    eqh_swept_t  := touch_eqh_xt
    eqh_swept_s  := f_sess_key(touch_eqh_xt)
    eqh_swept_o  := touch_eqh_bar
if eql_liq
    eql_swept_px := touch_eql_px
    eql_swept_t  := touch_eql_xt
    eql_swept_s  := f_sess_key(touch_eql_xt)
    eql_swept_o  := touch_eql_bar


// =============================================================
// STATE MACHINE
// 0 = IDLE | 1 = BEAR_SWEPT | 2 = BULL_SWEPT
// 3 = BEAR_FVG | 4 = BULL_FVG
// =============================================================

var int   state        = 0
var int   state_bar    = 0
// Bar of the SWEEP that opened the current cycle. state_bar gets overwritten
// at the MSS, so this is the one deadline that bounds the whole cycle: a
// structure break that fails to produce an entry re-arms back to the "waiting
// for structure" phase (see the re-arm blocks) rather than killing the setup,
// and this is what stops that from looping forever.
var int   sweep_bar    = 0

// The session the CURRENT cycle armed in — captured once at the sweep, not
// re-evaluated live. Used to abandon the cycle the instant that specific
// session ends, instead of letting it wait across the gap into the next one
// (see the reset block further down).
var bool  cyc_sess_asia = false
var bool  cyc_sess_lon  = false
var bool  cyc_sess_ny   = false

// The running extreme of the reaction, wick included — the stop anchor. The
// stop must sit beyond the real price reached, so this tracks every new wick
// extreme unconditionally.
var float sweep_hi     = na
var float sweep_lo     = na
// The extreme the CE is measured from (the leg it looks back along) and its
// bar. Same as the sweep extreme during a normal cycle; after a failed
// imbalance retest (use_fvg_entry) it restarts from the post-break extreme.
var float ce_ext_hi     = na
var int   ce_ext_hi_bar = na
var float ce_ext_lo     = na
var int   ce_ext_lo_bar = na
// Extreme printed after the structure break, while waiting for the retest:
// the new starting point if that retest fails and the cycle re-arms.
var float post_hi       = na
var int   post_hi_bar   = na
var float post_lo       = na
var int   post_lo_bar   = na
var float mss_ref_bear = na
var float mss_ref_bull = na
// Bar the CE level actually printed on (the swing/origin candle), so the line
// can be drawn starting there instead of at the liquidation bar.
var int   mss_ref_bar  = na
var float fvg_top      = na
var float fvg_bot      = na
var int   fvg_bar      = 0
var int   mss_bar      = 0

// Which POI level triggered the current active sweep cycle (if any), so its
// own line can turn green with a check instead of just disappearing once
// swept — it stays green through the whole sweep -> MSS -> entry cycle.
var float active_sweep_px = na

// The entry FVG is drawn as two plain dashed lines (top edge + bottom edge)
// instead of a filled box — a horizontal line (y1==y2) can never develop the
// absurd height a box could when its coordinates went stale, and dashed
// style makes it visually distinct at a glance from the solid POI lines and
// the imbalance lines.
var line  fvg_top_line = na
var line  fvg_bot_line = na
var label fvg_lbl      = na

// Pine functions can READ a global var but can never ASSIGN to one (that's
// CE10088, not just the tuple-":=" restriction from before) — so both
// helpers below only delete the underlying drawing objects / create new
// ones and RETURN the handles; every call site below assigns the result
// back to fvg_top_line/fvg_bot_line/fvg_lbl itself with ":=".
//
// Deletes the entry-FVG lines/label; returns the (now na) handles. Called
// at every point a cycle ends or restarts, so nothing from an old cycle can
// ever leak into a new one (that leak was the actual cause of the
// vertical-line render bug — see the fvg_top/fvg_bot reset at the sweep
// transitions below). Defined here (before ANY call site) — Pine requires
// a function to appear before its first use.
f_fvg_clear() =>
    line.delete(fvg_top_line)
    line.delete(fvg_bot_line)
    label.delete(fvg_lbl)
    line  l1 = na
    line  l2 = na
    label lb = na
    [l1, l2, lb]

// Draws the entry FVG as two plain dashed lines (top edge + bottom edge)
// instead of a filled box, extend=extend.right so they grow on their own —
// no per-bar "set_right" upkeep needed, and no box whose height can ever
// blow up. col is red for a bear (sell) zone, teal for a bull (buy) zone.
// Returns the new handles; does NOT delete the old ones itself — call
// f_fvg_clear() first at the call site.
f_fvg_draw(float top, float bot, bool bear_side) =>
    col = bear_side ? color.new(color.red, 10) : color.new(color.teal, 10)
    txt = bear_side ? "ENTRY FVG (Bear)" : "ENTRY FVG (Bull)"
    nl_top = line.new(bar_index - 2, top, bar_index + 1, top, extend = extend.right, color = col, style = line.style_dashed, width = 1)
    nl_bot = line.new(bar_index - 2, bot, bar_index + 1, bot, extend = extend.right, color = col, style = line.style_dashed, width = 1)
    nlb    = label.new(bar_index, bear_side ? bot : top, txt, style = label.style_label_down, color = color.new(color.black, 100), textcolor = col, size = size.small)
    [nl_top, nl_bot, nlb]

// Funnel diagnostics — where in sweep -> MSS -> FVG -> retest -> entry the
// setups are actually getting cut off. Shown in the info table so a zero-
// trade backtest is diagnosable at a glance instead of a black box.
var int cnt_sweep  = 0
var int cnt_mss    = 0
var int cnt_fvg    = 0
var int cnt_entry  = 0

// Live setup checklist — tracked per active cycle so the on-chart panel can
// show exactly which conditions still need to happen before an entry fires,
// checking each one off as soon as it's met. Reset at the start of every
// new cycle (a fresh sweep), not when it ends, so the final state stays
// visible for the checklist to render before the panel disappears.
var bool cyc_touched   = false
var bool cyc_close_ok  = false

// Phase visuals: sweep confirmed (the swept POI line itself turns green with
// a check, see f_poi_entry below) -> waiting for structure break (yellow CE
// level line) -> structure broken, entry FVG marked (below).
var line  mss_ref_line    = na
var label mss_ref_lbl     = na
// Small discreet marker AT the exact candle currently used as the CE origin —
// the line only shows the price level, not which candle it came from, so this
// answers "which candle is it actually counting as CE" at a glance. A plain
// small dot glyph (style_none) rather than label.style_circle's built-in
// circle shape, which renders noticeably larger even at size.tiny.
var label mss_ref_org     = na

// Structure-break ("CE") marker: only the CURRENT cycle's, only while the
// bot is actually hunting for an entry (state 3/4) — not a permanent
// plotshape history of every past break, per request.
var label ce_lbl = na

// SWEEP / LIQUIDATION — the setup arms the instant price crosses the level.
//
// The previous definition also required price to CLOSE back through the level
// before it counted as a sweep. While price stayed beyond the zone nothing was
// armed, so the setup only engaged when price came back and touched a second
// time — the zone sat there liquidated with no green check and no checklist,
// which is exactly what bar replay showed. Taking out the liquidity IS the
// event; the reaction is what we then wait for, not part of the trigger.
//
// *_liq (computed above, before the state machine) is true on the single bar
// price first trades through the level, edge-triggered by its own *_swept
// flag — the same "if not sweepPDH and high > prevHigh" the two working
// PDH/PDL strategies use.
hs_pdh  = use_pdhl and pdh_liq
hs_pwh  = use_pwhl and pwh_liq
hs_eqh  = use_eql  and eqh_liq
hs_imb  = use_htf_imb_entry and touch_bear_htf

ls_pdl  = use_pdhl and pdl_liq
ls_pwl  = use_pwhl and pwl_liq
ls_eql  = use_eql  and eql_liq
ls_imb  = use_htf_imb_entry and touch_bull_htf

htf_ok_bear = not use_htf or htf_bear
htf_ok_bull = not use_htf or htf_bull

// BUG FIX: in_kz used to gate sweep detection here, but the swept-state
// flags below (pdh_swept etc.) mark a level swept 24/7 regardless of kill
// zone — so a sweep outside London/NY hours (most of the day, especially
// visible on low timeframes where sweeps happen constantly) marked the
// level swept but never engaged the state machine, leaving no MSS wait, no
// green check, nothing — the line just vanished. Also silently discarded a
// large fraction of otherwise-valid setups. Kill zone timing is still
// tracked/shown (info table), just no longer a hard gate on the state
// machine engaging.
//
// Execution timeframe gate: the whole trading state machine — sweep
// recognition, MSS/CE, the FVG hunt, the checklist, entries — only ever
// engages on the 1-minute chart. Viewing this script on 1H/4H/D/M is for
// CONTEXT only (POI zones + imbalances still draw normally there); nothing
// operational should appear or fire outside the actual execution timeframe.
// Because state can then never leave 0 on a non-1m chart, this alone also
// suppresses the sweep-circle markers, CE label and checklist panel there —
// nothing extra needed at each of those call sites.
is_exec_tf = timeframe.period == "1"

// The whole cycle — sweep, CE wait, entry — must start AND finish inside the
// SAME session window (Asia/London/NY). A sweep during Asia that never
// breaks structure before Asia closes is NOT a standing setup waiting for
// London to open; it is a failed cycle, and the bot must wait for a fresh
// liquidation. Carrying an armed cycle across a session boundary breaks the
// statistical premise the sessions are meant to provide. Enforced two ways
// below: (1) a sweep can only ARM while some session window is open, and
// (2) if the session that armed the current cycle ends before an entry
// fires, the cycle is abandoned (see the reset block further down).
in_any_sess = in_asia or in_london or in_ny

any_hs = (hs_pdh or hs_pwh or hs_eqh or hs_imb) and htf_ok_bear and can_trade and is_exec_tf and in_any_sess
any_ls = (ls_pdl or ls_pwl or ls_eql or ls_imb)  and htf_ok_bull and can_trade and is_exec_tf and in_any_sess

// An imbalance manipulation in the OPPOSITE direction of the cycle currently
// being tracked takes priority: forget the old POI (whatever sweep armed it)
// and start fresh on the imbalance, same as the state==0 case below. Every
// other POI source only ever arms from state==0 — only imbalance touches can
// override an in-progress cycle, per explicit requirement.
hs_imb_gated = hs_imb and htf_ok_bear and can_trade and is_exec_tf
ls_imb_gated = ls_imb and htf_ok_bull and can_trade and is_exec_tf

if (state == 0 and any_hs) or (state == 2 and hs_imb_gated)
    state        := 1
    sweep_bar    := bar_index
    cyc_sess_asia := in_asia
    cyc_sess_lon  := in_london
    cyc_sess_ny   := in_ny
    // The liquidating candle IS the sweep candle now, so its own extreme seeds
    // the stop anchor; it then keeps tracking the reaction extreme while the
    // bot waits for structure (equivalent to maxAfterSweepPDH in the working
    // PDH/PDL strategy).
    sweep_hi     := high
    // CE = the low the push that took the liquidity started from (f_ce_ref).
    // Price CLOSING below it is the break.
    ce_ext_hi     := high
    ce_ext_hi_bar := bar_index
    [ce_arm_b, ce_arm_b_bar, ce_arm_b_ok] = f_ce_ref(true, 0)
    mss_ref_bear := na(ce_arm_b) ? low : ce_arm_b
    mss_ref_bar  := na(ce_arm_b_bar) ? bar_index : ce_arm_b_bar
    state_bar    := bar_index
    cnt_sweep    += 1
    cyc_touched   := false
    cyc_close_ok  := false
    // BUG FIX: fvg_top/fvg_bot were never cleared between cycles, so a brand
    // new cycle could inherit the PREVIOUS cycle's gap coordinates (a
    // completely different price level) until it happened to find its own
    // new gap. That stale zone could keep the FVG search running on the
    // wrong timeout (fvg_max_bars instead of fvg_search_bars, since the
    // na(fvg_top) check that picks between them was fooled by the leftover
    // value) with a box still anchored 2-3 bars wide at the old price — a
    // thin, absurdly tall box that renders as a vertical line. Clearing
    // both here, at the start of every fresh cycle, closes that off.
    fvg_top := na
    fvg_bot := na
    [tmp_fvg_l1, tmp_fvg_l2, tmp_fvg_lb] = f_fvg_clear()
    fvg_top_line := tmp_fvg_l1
    fvg_bot_line := tmp_fvg_l2
    fvg_lbl := tmp_fvg_lb
    active_sweep_px := hs_pdh ? pdh : hs_pwh ? pwh : hs_eqh ? touch_eqh_px : touch_bear_htf_edge
    // Phase 1: zone liquidated (its own line turns green with a check via
    // f_poi_entry), then show the level price must break through to confirm
    // a bearish structure shift.
    line.delete(mss_ref_line)
    label.delete(mss_ref_lbl)
    label.delete(mss_ref_org)
    mss_ref_line := line.new(nz(mss_ref_bar, bar_index), mss_ref_bear, bar_index + 1, mss_ref_bear, extend = extend.right, color = color.yellow, style = line.style_solid, width = 2)
    mss_ref_lbl  := label.new(bar_index, mss_ref_bear, "", style = label.style_none, textcolor = color.yellow, size = size.normal)
    mss_ref_org  := label.new(nz(mss_ref_bar, bar_index), mss_ref_bear, "•", xloc = xloc.bar_index, style = label.style_none, textcolor = color.yellow, size = size.tiny)

if (state == 0 and any_ls) or (state == 1 and ls_imb_gated)
    state        := 2
    sweep_bar    := bar_index
    cyc_sess_asia := in_asia
    cyc_sess_lon  := in_london
    cyc_sess_ny   := in_ny
    sweep_lo     := low
    // Mirror: the high the push down that took the liquidity started from.
    ce_ext_lo     := low
    ce_ext_lo_bar := bar_index
    [ce_arm_u, ce_arm_u_bar, ce_arm_u_ok] = f_ce_ref(false, 0)
    mss_ref_bull := na(ce_arm_u) ? high : ce_arm_u
    mss_ref_bar  := na(ce_arm_u_bar) ? bar_index : ce_arm_u_bar
    state_bar    := bar_index
    cnt_sweep    += 1
    cyc_touched   := false
    cyc_close_ok  := false
    fvg_top := na
    fvg_bot := na
    [tmp_fvg_l1, tmp_fvg_l2, tmp_fvg_lb] = f_fvg_clear()
    fvg_top_line := tmp_fvg_l1
    fvg_bot_line := tmp_fvg_l2
    fvg_lbl := tmp_fvg_lb
    active_sweep_px := ls_pdl ? pdl : ls_pwl ? pwl : ls_eql ? touch_eql_px : touch_bull_htf_edge
    line.delete(mss_ref_line)
    label.delete(mss_ref_lbl)
    label.delete(mss_ref_org)
    mss_ref_line := line.new(nz(mss_ref_bar, bar_index), mss_ref_bull, bar_index + 1, mss_ref_bull, extend = extend.right, color = color.yellow, style = line.style_solid, width = 2)
    mss_ref_lbl  := label.new(bar_index, mss_ref_bull, "", style = label.style_none, textcolor = color.yellow, size = size.normal)
    mss_ref_org  := label.new(nz(mss_ref_bar, bar_index), mss_ref_bull, "•", xloc = xloc.bar_index, style = label.style_none, textcolor = color.yellow, size = size.tiny)

if (state == 1 or state == 2) and (bar_index - sweep_bar) > mss_max_bars
    state := 0
    active_sweep_px := na
    label.delete(ce_lbl)
    ce_lbl := na
    line.delete(mss_ref_line)
    label.delete(mss_ref_lbl)
    label.delete(mss_ref_org)
    mss_ref_line    := na
    mss_ref_lbl     := na
    mss_ref_org     := na

// The session that armed this cycle just ended — abandon it rather than
// carry the wait (for the structure break OR, further along, for the entry)
// into the next session. Covers every non-idle state, since a break
// confirmed in Asia waiting on can_trade_entry for London to open is exactly
// the cross-session carryover this exists to prevent.
sess_carried_over = state != 0 and not ((cyc_sess_asia and in_asia) or (cyc_sess_lon and in_london) or (cyc_sess_ny and in_ny))
if sess_carried_over
    state := 0
    active_sweep_px := na
    label.delete(ce_lbl)
    ce_lbl := na
    line.delete(mss_ref_line)
    label.delete(mss_ref_lbl)
    label.delete(mss_ref_org)
    mss_ref_line    := na
    mss_ref_lbl     := na
    mss_ref_org     := na

// Checked BEFORE the reference is re-anchored with this bar's own extreme,
// so "close breaks the structure formed so far" and "this bar becomes the new
// structure point" can never both be true on the same bar.
// bar_index > sweep_bar: the break must happen on a LATER candle than the
// sweep. Without it, a sweep candle that already closes past the last swing
// (a steep rally whose final pullback sits close to the level) would register
// the sweep and the structure break on the very same candle, which is not a
// reaction to anything. Taken from the working PDH/PDL strategy, which guards
// its BOS the same way.
bear_mss = state == 1 and bar_index > sweep_bar and not na(mss_ref_bear) and close < mss_ref_bear
bull_mss = state == 2 and bar_index > sweep_bar and not na(mss_ref_bull) and close > mss_ref_bull

// WHEN THE CE MOVES. Only when a candle CLOSES beyond the current extreme of
// the move (a close above it in a short setup, below it in a long one — a
// wick beyond it is annulled, see CLOSE RULE): that new push has
// its own starting swing, recomputed with f_ce_ref from the new extreme. The
// new level is adopted only if the pullback it found is MORE RECENT than the
// current CE (the reference never jumps back in time to an older, deeper
// swing) and it genuinely qualified (not the no-pullback fallback). So:
//   - marginal new extremes inside one push find no new qualifying pullback
//     and leave the CE where it is;
//   - a real pullback followed by a new extreme moves the CE to the low
//     (high) that new push started from — the textbook trailing CHoCH level;
//   - a pullback AFTER the extreme that is not followed by a new extreme
//     never moves the CE (it did not create any extreme; the old ratchet
//     adopted exactly those and put the CE on minor internal swings).
if state == 1 and not bear_mss
    if high > sweep_hi
        sweep_hi := high
    if close > ce_ext_hi
        ce_ext_hi     := high
        ce_ext_hi_bar := bar_index
        [ce_mv_b, ce_mv_b_bar, ce_mv_b_ok] = f_ce_ref(true, 0)
        if ce_mv_b_ok and (na(mss_ref_bar) or ce_mv_b_bar > mss_ref_bar)
            mss_ref_bear := ce_mv_b
            mss_ref_bar  := ce_mv_b_bar
    else if high > ce_ext_hi and not f_swing_sig(ce_ext_hi, ce_ext_hi_bar, true)
        // Wick within a swing still forming: the level is the deepest wick.
        ce_ext_hi     := high
        ce_ext_hi_bar := bar_index
    if not na(mss_ref_line)
        // x1 must move too — a relocation moves the CE to a DIFFERENT candle,
        // not just a different price, so the line's start needs to follow.
        line.set_x1(mss_ref_line, mss_ref_bar)
        line.set_y1(mss_ref_line, mss_ref_bear)
        line.set_y2(mss_ref_line, mss_ref_bear)
        label.set_y(mss_ref_lbl, mss_ref_bear)
        label.set_xy(mss_ref_org, mss_ref_bar, mss_ref_bear)
// Bull setup: mirror.
if state == 2 and not bull_mss
    if low < sweep_lo
        sweep_lo := low
    if close < ce_ext_lo
        ce_ext_lo     := low
        ce_ext_lo_bar := bar_index
        [ce_mv_u, ce_mv_u_bar, ce_mv_u_ok] = f_ce_ref(false, 0)
        if ce_mv_u_ok and (na(mss_ref_bar) or ce_mv_u_bar > mss_ref_bar)
            mss_ref_bull := ce_mv_u
            mss_ref_bar  := ce_mv_u_bar
    else if low < ce_ext_lo and not f_swing_sig(ce_ext_lo, ce_ext_lo_bar, false)
        ce_ext_lo     := low
        ce_ext_lo_bar := bar_index
    if not na(mss_ref_line)
        line.set_x1(mss_ref_line, mss_ref_bar)
        line.set_y1(mss_ref_line, mss_ref_bull)
        line.set_y2(mss_ref_line, mss_ref_bull)
        label.set_y(mss_ref_lbl, mss_ref_bull)
        label.set_xy(mss_ref_org, mss_ref_bar, mss_ref_bull)

// use_fvg_entry OFF (default): the break IS the entry, so the cycle goes
// straight to a PENDING-entry phase rather than into the FVG-hunting states.
//
// Structure confirmed broken: FREEZE the reference line instead of deleting
// it — it now shows exactly what CE means (origin candle to structure break)
// and stays on the chart, unmoving, until the next cycle's fresh line
// replaces it. Deleting it here (the old behaviour) is exactly the
// "disappears the moment structure breaks" the user didn't want.
if bear_mss
    mss_bar      := bar_index
    state        := 3
    state_bar    := bar_index
    cnt_mss      += 1
    post_hi      := high
    post_hi_bar  := bar_index
    if not na(mss_ref_line)
        line.set_x2(mss_ref_line, bar_index)
        line.set_extend(mss_ref_line, extend.none)
    label.delete(ce_lbl)
    // With the CE history layer on, this candle already carries its "CE"
    // mark and the yellow line: no second label.
    ce_lbl := na
    if not ce_hist
        ce_lbl := label.new(bar_index, high, "CE", style = label.style_label_down, color = color.orange, textcolor = color.black, size = size.tiny)

if bull_mss
    mss_bar      := bar_index
    state        := 4
    state_bar    := bar_index
    cnt_mss      += 1
    post_lo      := low
    post_lo_bar  := bar_index
    if not na(mss_ref_line)
        line.set_x2(mss_ref_line, bar_index)
        line.set_extend(mss_ref_line, extend.none)
    label.delete(ce_lbl)
    ce_lbl := na
    if not ce_hist
        ce_lbl := label.new(bar_index, low, "CE", style = label.style_label_up, color = color.orange, textcolor = color.black, size = size.tiny)

// ROOT CAUSE #3 + "closest imbalance" rule. The old code checked
// mss_bear_ok[1] — exactly one bar after the structure break — and gave up
// entirely if that single bar left no 3-candle gap (impulses usually run
// several bars; the gap can appear on the 2nd-4th bar, not just the 1st).
// That was the MSS=4 -> FVG=2 attrition.
//
// It also locked onto the FIRST gap found. But as the impulse continues,
// each new gap forms progressively CLOSER to where price currently is — so
// "the imbalance closest to current price" (the user's rule when several
// form) is whichever one is MOST RECENT, not the first. So this overwrites
// fvg_top/fvg_bot with the latest qualifying gap, for as long as price
// hasn't already retraced back into the current one.
//
// ROOT CAUSE #5 — "the entry fires an hour later, nowhere near the break".
// That overwrite had NO window: it kept re-anchoring to the newest gap for
// up to fvg_max_bars (60 bars = a full hour on 1m). In a sustained impulse
// each new gap forms higher than the last, so the tracked entry zone chased
// price all the way up the leg and only triggered when price finally pulled
// back into the LAST gap — near the top of the move, ~an hour after the
// structure break, instead of at the reaction imbalance right after it.
//
// The imbalance that matters is the one created BY THE REACTION that broke
// structure — the first gap the impulse leaves right at the break. That is
// also the one "closest to price" at the moment the decision is made, and
// the only one that keeps the stop pinned tight to the sweep wick (an
// imbalance eight bars up the leg puts the sweep low so far away that the
// 1:2 RR is measured off a huge stop, which is not the setup).
//
// So: the FIRST qualifying gap after the MSS wins and the zone is then
// LOCKED — no re-anchoring at all. The search is additionally confined to
// fvg_search_bars bars after the MSS.
//
// When that window passes with no gap, or the locked zone is never retested,
// the cycle RE-ARMS to the "waiting for structure" phase instead of dying.
// This is required by the local structure reference (ROOT CAUSE #6): a local
// reference legitimately triggers on intermediate bounces during a long move
// down to the real reaction low. Killing the cycle on the first such break
// would leave the bot disarmed by the time the real reaction arrives — the
// sweep is edge-triggered and will not fire again — so it would simply never
// take the trade. Re-arming keeps it hunting until either a valid entry
// appears or the whole cycle times out mss_max_bars after the sweep.
rearm_ok = (bar_index - sweep_bar) <= mss_max_bars
if state == 3 and bar_index > mss_bar and high > post_hi and (close > post_hi or not f_swing_sig(post_hi, post_hi_bar, true))
    post_hi     := high
    post_hi_bar := bar_index
if state == 4 and bar_index > mss_bar and low < post_lo and (close < post_lo or not f_swing_sig(post_lo, post_lo_bar, false))
    post_lo     := low
    post_lo_bar := bar_index
if use_fvg_entry and state == 3 and bar_index > mss_bar
    in_search_window = (bar_index - mss_bar) <= fvg_search_bars
    if na(fvg_top) and in_search_window
        bear_gap = low[2] - high
        // Sanity ceiling: a genuine data anomaly (weekend gap, bad tick) can
        // otherwise produce a "gap" many times wider than any real trade
        // setup.
        if bear_gap >= fvg_min_gap and bear_gap <= max_sl * 5
            if na(fvg_top)
                cnt_fvg += 1
            fvg_top := low[2]
            fvg_bot := high
            fvg_bar := bar_index
            [tmp_fvg_l1, tmp_fvg_l2, tmp_fvg_lb] = f_fvg_clear()
            [tmp_fvg_d1, tmp_fvg_d2, tmp_fvg_db] = f_fvg_draw(fvg_top, fvg_bot, true)
            fvg_top_line := tmp_fvg_d1
            fvg_bot_line := tmp_fvg_d2
            fvg_lbl := tmp_fvg_db
    bear_failed = (na(fvg_top) and (bar_index - mss_bar) >= fvg_search_bars) or (not na(fvg_top) and (bar_index - mss_bar) > fvg_max_bars)
    if bear_failed
        [tmp_fvg_l1, tmp_fvg_l2, tmp_fvg_lb] = f_fvg_clear()
        fvg_top_line := tmp_fvg_l1
        fvg_bot_line := tmp_fvg_l2
        fvg_lbl := tmp_fvg_lb
        fvg_top := na
        fvg_bot := na
        label.delete(ce_lbl)
        ce_lbl := na
        if rearm_ok
            // Back to hunting for the real structure break. The new CE is
            // measured from the high printed after the failed break: the
            // low that push started from.
            state         := 1
            ce_ext_hi     := post_hi
            ce_ext_hi_bar := post_hi_bar
            [ce_re_b, ce_re_b_bar, ce_re_b_ok] = f_ce_ref(true, bar_index - post_hi_bar)
            mss_ref_bear := na(ce_re_b) ? low : ce_re_b
            mss_ref_bar  := na(ce_re_b_bar) ? bar_index : ce_re_b_bar
            // Already broken (price closed below it since): not a new CE to
            // wait for — the cycle is over, not re-broken on the next bar.
            if mss_ref_bear >= close
                state := 0
                active_sweep_px := na
            if state == 1
                line.delete(mss_ref_line)
                label.delete(mss_ref_lbl)
                label.delete(mss_ref_org)
                mss_ref_line := line.new(nz(mss_ref_bar, bar_index), mss_ref_bear, bar_index + 1, mss_ref_bear, extend = extend.right, color = color.yellow, style = line.style_solid, width = 2)
                mss_ref_lbl  := label.new(bar_index, mss_ref_bear, "", style = label.style_none, textcolor = color.yellow, size = size.normal)
                mss_ref_org  := label.new(nz(mss_ref_bar, bar_index), mss_ref_bear, "•", xloc = xloc.bar_index, style = label.style_none, textcolor = color.yellow, size = size.tiny)
        else
            state := 0
            active_sweep_px := na

if use_fvg_entry and state == 4 and bar_index > mss_bar
    in_search_window = (bar_index - mss_bar) <= fvg_search_bars
    if na(fvg_top) and in_search_window
        bull_gap = low - high[2]
        if bull_gap >= fvg_min_gap and bull_gap <= max_sl * 5
            if na(fvg_top)
                cnt_fvg += 1
            fvg_top := low
            fvg_bot := high[2]
            fvg_bar := bar_index
            [tmp_fvg_l1, tmp_fvg_l2, tmp_fvg_lb] = f_fvg_clear()
            [tmp_fvg_d1, tmp_fvg_d2, tmp_fvg_db] = f_fvg_draw(fvg_top, fvg_bot, false)
            fvg_top_line := tmp_fvg_d1
            fvg_bot_line := tmp_fvg_d2
            fvg_lbl := tmp_fvg_db
    bull_failed = (na(fvg_top) and (bar_index - mss_bar) >= fvg_search_bars) or (not na(fvg_top) and (bar_index - mss_bar) > fvg_max_bars)
    if bull_failed
        [tmp_fvg_l1, tmp_fvg_l2, tmp_fvg_lb] = f_fvg_clear()
        fvg_top_line := tmp_fvg_l1
        fvg_bot_line := tmp_fvg_l2
        fvg_lbl := tmp_fvg_lb
        fvg_top := na
        fvg_bot := na
        label.delete(ce_lbl)
        ce_lbl := na
        if rearm_ok
            state         := 2
            ce_ext_lo     := post_lo
            ce_ext_lo_bar := post_lo_bar
            [ce_re_u, ce_re_u_bar, ce_re_u_ok] = f_ce_ref(false, bar_index - post_lo_bar)
            mss_ref_bull := na(ce_re_u) ? high : ce_re_u
            mss_ref_bar  := na(ce_re_u_bar) ? bar_index : ce_re_u_bar
            if mss_ref_bull <= close
                state := 0
                active_sweep_px := na
            if state == 2
                line.delete(mss_ref_line)
                label.delete(mss_ref_lbl)
                label.delete(mss_ref_org)
                mss_ref_line := line.new(nz(mss_ref_bar, bar_index), mss_ref_bull, bar_index + 1, mss_ref_bull, extend = extend.right, color = color.yellow, style = line.style_solid, width = 2)
                mss_ref_lbl  := label.new(bar_index, mss_ref_bull, "", style = label.style_none, textcolor = color.yellow, size = size.normal)
                mss_ref_org  := label.new(nz(mss_ref_bar, bar_index), mss_ref_bull, "•", xloc = xloc.bar_index, style = label.style_none, textcolor = color.yellow, size = size.tiny)
        else
            state := 0
            active_sweep_px := na

// =============================================================
// ENTRY CONDITIONS
// =============================================================

in_bear_fvg = state == 3 and not na(fvg_top) and not na(fvg_bot)
in_bull_fvg = state == 4 and not na(fvg_top) and not na(fvg_bot)

touched_bear = in_bear_fvg and high >= fvg_bot and low <= fvg_top
touched_bull = in_bull_fvg and low  <= fvg_top and high >= fvg_bot

close_ok_bear  = req_close_fvg ? (close >= fvg_bot and close <= fvg_top and is_bear) : is_bear
close_ok_bull  = req_close_fvg ? (close >= fvg_bot and close <= fvg_top and is_bull) : is_bull

// Default path: liquidity taken, CE level broken, order goes in the moment
// London/NY is open. The imbalance-retest path is kept intact behind
// use_fvg_entry for later.
//
// PENDING ENTRY: short_signal/long_signal check "are we sitting in the
// post-break, waiting-for-entry phase" (state == 3/4) rather than the
// one-bar bear_mss/bull_mss edge. The break itself is detected 24/7 on
// purpose (a break at 3 AM is still structurally real) but the ORDER only
// ever fires in London/NY (can_trade_entry). Tying the signal to the single
// break bar meant a break outside session hours missed can_trade_entry on
// that one bar and the setup was gone for good — the vast majority of
// breaks happen outside the ~4.5 session hours in a day. Checking the
// PHASE instead lets a break that happens overnight sit parked (sl/tp
// already frozen to sweep_hi/sweep_lo the moment the break confirmed) and
// fire the instant the next session opens, bounded by the existing
// mss_max_bars deadline below (measured from the original sweep, so it
// can't wait forever either).
short_signal = (use_fvg_entry ? (touched_bear and close_ok_bear) : state == 3) and can_trade_entry
long_signal  = (use_fvg_entry ? (touched_bull and close_ok_bull) : state == 4) and can_trade_entry

// Checklist progress for the current cycle — "ever true so far this cycle",
// not "true on this exact bar" (entry still needs all three aligned on the
// same bar; this is a progress readout, not a substitute for short/long_signal).
if touched_bear or touched_bull
    cyc_touched := true
if (touched_bear and close_ok_bear) or (touched_bull and close_ok_bull)
    cyc_close_ok := true

// =============================================================
// ORDER EXECUTION
// =============================================================

// ROOT CAUSE #4 (FVG=2 -> Entries=0). SL is placed at the sweep wick. By the
// time a setup completes — sweep, then an impulse leg breaking structure,
// then a retrace back into the gap — the distance from entry back up to that
// wick is frequently well beyond max_sl (50 pips). The old code treated that
// as "reject the trade entirely", silently discarding otherwise-valid
// signals and never reaching strategy.entry at all. It also plotted the
// SHORT/LONG marker from short_signal/long_signal alone, so the chart could
// show an entry arrow even on a bar where the trade was actually rejected —
// exactly the "marker but nothing in the Strategy Tester" the user saw.
//
// Now sl/tp/qty are computed unconditionally (na-safe) so a single validated
// boolean (short_valid/long_valid) gates the order and its alert — they can
// never disagree. When the structural stop
// is too wide it's CAPPED at max_sl instead of dropping the trade
// (cap_sl_to_max, on by default); risk per trade stays bounded either way
// since size is derived from the real stop distance.
sl_struct_s = sweep_hi + sweep_buf
sl_price_s  = cap_sl_to_max ? math.min(sl_struct_s, close + max_sl) : sl_struct_s
sl_dist_s   = sl_price_s - close
tp_price_s  = close - (sl_price_s - close) * rr_ratio
qty_s       = f_qty(sl_dist_s)
short_valid = short_signal and sl_dist_s >= min_sl and sl_dist_s <= max_sl and qty_s > 0

sl_struct_l = sweep_lo - sweep_buf
sl_price_l  = cap_sl_to_max ? math.max(sl_struct_l, close - max_sl) : sl_struct_l
sl_dist_l   = close - sl_price_l
tp_price_l  = close + (close - sl_price_l) * rr_ratio
qty_l       = f_qty(sl_dist_l)
long_valid  = long_signal and sl_dist_l >= min_sl and sl_dist_l <= max_sl and qty_l > 0

if short_valid and order_bar
    strategy.entry("Short", strategy.short, qty = qty_s, comment = "S")
    strategy.exit("SX", from_entry = "Short", stop = sl_price_s, limit = tp_price_s, comment_profit = "TP", comment_loss = "SL")
    trades_today += 1
    cnt_entry    += 1
    if in_london
        lon_session_trades += 1
    if in_ny
        ny_session_trades += 1
    state := 0
    active_sweep_px := na
    // ce_lbl is deliberately left on the chart, as is mss_ref_line (now
    // frozen origin-candle-to-break-candle): the visual proof of why the
    // order went in. The next cycle's break replaces both.
    [tmp_fvg_l1, tmp_fvg_l2, tmp_fvg_lb] = f_fvg_clear()
    fvg_top_line := tmp_fvg_l1
    fvg_bot_line := tmp_fvg_l2
    fvg_lbl := tmp_fvg_lb

if long_valid and order_bar
    strategy.entry("Long", strategy.long, qty = qty_l, comment = "L")
    strategy.exit("LX", from_entry = "Long", stop = sl_price_l, limit = tp_price_l, comment_profit = "TP", comment_loss = "SL")
    trades_today += 1
    cnt_entry    += 1
    if in_london
        lon_session_trades += 1
    if in_ny
        ny_session_trades += 1
    state := 0
    active_sweep_px := na
    // ce_lbl is deliberately left on the chart, as is mss_ref_line (now
    // frozen origin-candle-to-break-candle): the visual proof of why the
    // order went in. The next cycle's break replaces both.
    [tmp_fvg_l1, tmp_fvg_l2, tmp_fvg_lb] = f_fvg_clear()
    fvg_top_line := tmp_fvg_l1
    fvg_bot_line := tmp_fvg_l2
    fvg_lbl := tmp_fvg_lb

// =============================================================
// CE HISTORY — every structure change, to audit the CE rule
// =============================================================
// A continuous structure tracker that uses EXACTLY the rules the entries use
// (f_ce_ref + CLOSE RULE, same inputs). A CE is drawn every time a candle
// CLOSES beyond structure — a wick beyond it is annulled and draws nothing:
//   - reversal: while price pushes up, a close below the low that push
//     started from (bearish CE); the tracker then flips and waits for a close
//     above the high the decline started from (bullish CE), and so on;
//   - continuation: a close beyond the last valid extreme after a real
//     pullback (the move surpassed the previous one with a candle). Drawn at
//     that previous extreme — the level that was actually broken, not the
//     wicks that poked through it earlier without closing.
// Each CE inside Asia/London/NY is drawn — a dotted line from the swing it
// sat on to the candle that closed through it, plus a small "CE" — trade or
// no trade. Execution timeframe (1m) only, like every other operational
// marker.
var int   trk_dir     = 0      // -1: rising, waiting for a bearish CE | 1: falling, waiting for a bullish CE
var float trk_ext     = na     // last valid extreme of the move (moved only by closes beyond it)
var int   trk_ext_bar = na
var float trk_ref     = na     // current CE level (start of the final leg into trk_ext)
var int   trk_ref_bar = na
var line[]  ce_hist_lines  = array.new<line>(0)
var label[] ce_hist_labels = array.new<label>(0)

f_ce_hist_draw(int x1, float y, bool bear_brk) =>
    col = bear_brk ? color.new(color.red, 15) : color.new(color.teal, 15)
    nl  = line.new(x1, y, bar_index, y, color = col, style = line.style_dotted, width = 1)
    nlb = label.new(bar_index, y, "CE", style = bear_brk ? label.style_label_upper_left : label.style_label_lower_left, color = color.new(color.black, 100), textcolor = col, size = size.tiny)
    array.push(ce_hist_lines, nl)
    array.push(ce_hist_labels, nlb)
    if array.size(ce_hist_lines) > ce_hist_max
        line.delete(array.shift(ce_hist_lines))
        label.delete(array.shift(ce_hist_labels))
    array.size(ce_hist_lines)

if ce_hist and is_exec_tf and bar_index > ce_scan_bars
    if trk_dir == 0
        trk_dir     := -1
        trk_ext     := high
        trk_ext_bar := bar_index
        [tr0, tr0_bar, tr0_ok] = f_ce_ref(true, 0)
        trk_ref     := tr0
        trk_ref_bar := tr0_bar
    else if trk_dir == -1
        if not na(trk_ref) and bar_index > trk_ext_bar and close < trk_ref
            // Reversal (bearish CE). The new move's extreme is this candle's
            // own low: earlier wicks below the level never closed there.
            if in_any_sess
                f_ce_hist_draw(trk_ref_bar, trk_ref, true)
            trk_dir     := 1
            trk_ext     := low
            trk_ext_bar := bar_index
            [tf1, tf1_bar, tf1_ok] = f_ce_ref(false, 0)
            trk_ref     := tf1
            trk_ref_bar := tf1_bar
        else if close > trk_ext
            // New high by CLOSE: it broke the level (the deepest wick of the
            // swing). If a real pullback separates them, that high was
            // structure: continuation CE at the previous level — only if it
            // is an established swing; micro bounces inside a trend are not.
            old_ext     = trk_ext
            old_ext_bar = trk_ext_bar
            old_sig     = f_leg_real(old_ext, old_ext_bar, true)
            trk_ext     := high
            trk_ext_bar := bar_index
            [tm1, tm1_bar, tm1_ok] = f_ce_ref(true, 0)
            if tm1_ok and (na(trk_ref_bar) or tm1_bar > trk_ref_bar)
                trk_ref     := tm1
                trk_ref_bar := tm1_bar
                if in_any_sess and old_sig
                    f_ce_hist_draw(old_ext_bar, old_ext, false)
        else if high > trk_ext and not f_swing_sig(trk_ext, trk_ext_bar, true)
            // Wick beyond the level while that swing is still forming (the
            // next candle's wick went a bit higher): the LEVEL is the highest
            // wick. Not a break (no close beyond it). After a real pullback
            // the same wick is a retest and is annulled (falls through).
            trk_ext     := high
            trk_ext_bar := bar_index
    else
        if not na(trk_ref) and bar_index > trk_ext_bar and close > trk_ref
            // Reversal (bullish CE); mirror.
            if in_any_sess
                f_ce_hist_draw(trk_ref_bar, trk_ref, false)
            trk_dir     := -1
            trk_ext     := high
            trk_ext_bar := bar_index
            [tf2, tf2_bar, tf2_ok] = f_ce_ref(true, 0)
            trk_ref     := tf2
            trk_ref_bar := tf2_bar
        else if close < trk_ext
            old_ext_d     = trk_ext
            old_ext_bar_d = trk_ext_bar
            old_sig_d     = f_leg_real(old_ext_d, old_ext_bar_d, false)
            trk_ext     := low
            trk_ext_bar := bar_index
            [tm2, tm2_bar, tm2_ok] = f_ce_ref(false, 0)
            if tm2_ok and (na(trk_ref_bar) or tm2_bar > trk_ref_bar)
                trk_ref     := tm2
                trk_ref_bar := tm2_bar
                if in_any_sess and old_sig_d
                    f_ce_hist_draw(old_ext_bar_d, old_ext_d, true)
        else if low < trk_ext and not f_swing_sig(trk_ext, trk_ext_bar, false)
            trk_ext     := low
            trk_ext_bar := bar_index

// =============================================================
// VISUALS — session range boxes (Asia/London/NY), instead of a flat
// full-height background strip: a box bounding the session's actual
// traded high/low, growing live while the session is in progress and
// freezing once it ends. Oldest boxes drop off past sess_box_max so
// history doesn't accumulate forever.
// =============================================================

// No border: a box's left/right edges are vertical lines (and on a session's
// first bar left == right, so the border was a vertical line through the
// candle). Fill only.
f_session_box(bool in_session, bool prev_in_session, float sess_h, float sess_l, color line_col, color fill_col, string txt, box[] arr) =>
    if in_session and not prev_in_session
        nb = box.new(bar_index, sess_h, bar_index, sess_l, border_color = na, border_width = 0, bgcolor = fill_col, text = txt, text_color = line_col, text_size = size.small, text_halign = text.align_center, text_valign = text.align_top)
        array.push(arr, nb)
        if array.size(arr) > sess_box_max
            box.delete(array.shift(arr))
    if in_session and array.size(arr) > 0
        last_box = array.get(arr, array.size(arr) - 1)
        box.set_top(last_box, sess_h)
        box.set_bottom(last_box, sess_l)
        box.set_right(last_box, bar_index)

var box[] asia_boxes = array.new<box>(0)
var box[] lon_boxes  = array.new<box>(0)
var box[] ny_boxes   = array.new<box>(0)

// Boxes only by default — the name text is opt-in (show_session_labels).
asia_lbl_txt = show_session_labels ? asia_box_txt : ""
lon_lbl_txt  = show_session_labels ? lon_box_txt  : ""
ny_lbl_txt   = show_session_labels ? ny_box_txt   : ""

if show_asia_box and chart_sec <= 3600
    f_session_box(in_asia,   in_asia[1],   asia_live_h, asia_live_l, color.new(asia_box_col, 40), color.new(asia_box_col, 90), asia_lbl_txt, asia_boxes)
if show_lon_box and chart_sec <= 3600
    f_session_box(in_london, in_london[1], lon_live_h,  lon_live_l,  color.new(lon_box_col,  40), color.new(lon_box_col,  90), lon_lbl_txt,  lon_boxes)
if show_ny_box and chart_sec <= 3600
    f_session_box(in_ny,     in_ny[1],     ny_live_h,   ny_live_l,   color.new(ny_box_col,   30), color.new(ny_box_col,   90), ny_lbl_txt,   ny_boxes)

// =============================================================
// POI LINE MANAGER — rebuilt every bar with merge logic
// =============================================================

var line[]  managed_poi_lines  = array.new<line>(0)
var label[] managed_poi_labels = array.new<label>(0)


// Fires the instant each zone is actually crossed (not just approached) —
// "POI Liquidado: <zone>" as the alert() message doubles as the alert
// title when the user creates a TradingView alert on "Any alert() function
// call", and each alertcondition() below (near the rest of the
// alertconditions) gives its own title too when picked individually.
if use_sweep_alert and pdh_liq
    alert("POI Liquidado: PDH (Previous Day High) @ " + str.tostring(pdh, "#.#####"), alert.freq_once_per_bar)
if use_sweep_alert and pdl_liq
    alert("POI Liquidado: PDL (Previous Day Low) @ " + str.tostring(pdl, "#.#####"), alert.freq_once_per_bar)
if use_sweep_alert and pwh_liq
    alert("POI Liquidado: PWH (Previous Week High) @ " + str.tostring(pwh, "#.#####"), alert.freq_once_per_bar)
if use_sweep_alert and pwl_liq
    alert("POI Liquidado: PWL (Previous Week Low) @ " + str.tostring(pwl, "#.#####"), alert.freq_once_per_bar)
if use_sweep_alert and eqh_liq
    alert("POI Liquidado: Equal Highs @ " + str.tostring(touch_eqh_px, "#.#####"), alert.freq_once_per_bar)
if use_sweep_alert and eql_liq
    alert("POI Liquidado: Equal Lows @ " + str.tostring(touch_eql_px, "#.#####"), alert.freq_once_per_bar)

// =============================================================
// PROXIMITY ALERTS — hysteresis armed/disarmed per zone:
//   - "armed" zone whose distance drops to <= near_dist (0.2%) fires
//     once and disarms, so it doesn't re-fire every bar while price
//     lingers close.
//   - it only re-arms once price moves away beyond near_reset_dist
//     (1%), so a small wiggle around the 0.2% line can't spam alerts.
//   - also re-arms whenever the underlying level itself refreshes
//     (new day/week/Asia session/EQH-EQL) since that's effectively a
//     brand new zone.
// =============================================================

f_near(float px) =>
    not na(px) and math.abs(close - px) <= near_dist

f_far(float px) =>
    na(px) or math.abs(close - px) > near_reset_dist

var bool pdh_armed   = true
var bool pdl_armed   = true
var bool pwh_armed   = true
var bool pwl_armed   = true
var bool eqh_armed   = true
var bool eql_armed   = true

if is_new_day
    pdh_armed   := true
    pdl_armed   := true
if is_new_week
    pwh_armed   := true
    pwl_armed   := true
if eqh_new
    eqh_armed   := true
if eql_new
    eql_armed   := true

pdh_cond   = use_near_alert and use_pdhl and not pdh_swept    and f_near(pdh)
pdl_cond   = use_near_alert and use_pdhl and not pdl_swept    and f_near(pdl)
pwh_cond   = use_near_alert and use_pwhl and not pwh_swept    and f_near(pwh)
pwl_cond   = use_near_alert and use_pwhl and not pwl_swept    and f_near(pwl)
[eqh_nearest_px, eqh_nearest_bar] = f_eqh_nearest(eqh_arr, eqh_bar_arr)
[eql_nearest_px, eql_nearest_bar] = f_eqh_nearest(eql_arr, eql_bar_arr)
eqh_cond   = use_near_alert and use_eql  and f_near(eqh_nearest_px)
eql_cond   = use_near_alert and use_eql  and f_near(eql_nearest_px)

pdh_near_alert   = pdh_armed   and pdh_cond
pdl_near_alert   = pdl_armed   and pdl_cond
pwh_near_alert   = pwh_armed   and pwh_cond
pwl_near_alert   = pwl_armed   and pwl_cond
eqh_near_alert   = eqh_armed   and eqh_cond
eql_near_alert   = eql_armed   and eql_cond

if pdh_near_alert
    pdh_armed   := false
if pdl_near_alert
    pdl_armed   := false
if pwh_near_alert
    pwh_armed   := false
if pwl_near_alert
    pwl_armed   := false
if eqh_near_alert
    eqh_armed   := false
if eql_near_alert
    eql_armed   := false

if f_far(pdh)
    pdh_armed   := true
if f_far(pdl)
    pdl_armed   := true
if f_far(pwh)
    pwh_armed   := true
if f_far(pwl)
    pwl_armed   := true
if f_far(eqh_nearest_px)
    eqh_armed   := true
if f_far(eql_nearest_px)
    eql_armed   := true

if pdh_near_alert
    alert("Price approaching PDH (Previous Day High) - " + str.tostring(pdh, "#.#####"), alert.freq_once_per_bar)
if pdl_near_alert
    alert("Price approaching PDL (Previous Day Low) - " + str.tostring(pdl, "#.#####"), alert.freq_once_per_bar)
if pwh_near_alert
    alert("Price approaching PWH (Previous Week High) - " + str.tostring(pwh, "#.#####"), alert.freq_once_per_bar)
if pwl_near_alert
    alert("Price approaching PWL (Previous Week Low) - " + str.tostring(pwl, "#.#####"), alert.freq_once_per_bar)
if eqh_near_alert
    alert("Price approaching Equal Highs liquidity pool - " + str.tostring(eqh_nearest_px, "#.#####"), alert.freq_once_per_bar)
if eql_near_alert
    alert("Price approaching Equal Lows liquidity pool - " + str.tostring(eql_nearest_px, "#.#####"), alert.freq_once_per_bar)

// =============================================================
// FVG / IMBALANCE STATE — tracked here (before the POI arrays are
// built below) so every imbalance can be pushed into the SAME merge
// system as PDH/PDL/Asia/EQH-EQL: if a zone lands within merge_tol of
// another, they collapse into one line whose label lists every name.
// =============================================================

f_imb_in_rng(float px) =>
    not na(px) and math.abs(close - px) <= imb_dist

// Near-edge price of each HTF zone: the array-nearest-to-price value
// (htf_*_edge), computed once per bar above along with htf_*_org (its
// origin time) — kept under the *_px name since that's what the proximity
// alerts and POI-merge push below already expect.
htf_b1h_px = htf_b1h_edge
htf_u1h_px = htf_u1h_edge
htf_b4h_px = htf_b4h_edge
htf_u4h_px = htf_u4h_edge
htf_bd_px  = htf_bd_edge
htf_ud_px  = htf_ud_edge
htf_bw_px  = htf_bw_edge
htf_uw_px  = htf_uw_edge
htf_bm_px  = htf_bm_edge
htf_um_px  = htf_um_edge

// "New edge" for the proximity-alert re-arm below: the nearest tracked
// origin changed since last bar — either a fresh gap became the nearest one,
// or the previous nearest one got mitigated and a different one took over.
new_bear_1h = htf_b1h_org != htf_b1h_org[1]
new_bull_1h = htf_u1h_org != htf_u1h_org[1]
new_bear_4h = htf_b4h_org != htf_b4h_org[1]
new_bull_4h = htf_u4h_org != htf_u4h_org[1]
new_bear_d  = htf_bd_org  != htf_bd_org[1]
new_bull_d  = htf_ud_org  != htf_ud_org[1]
new_bear_w  = htf_bw_org  != htf_bw_org[1]
new_bull_w  = htf_uw_org  != htf_uw_org[1]
new_bear_m  = htf_bm_org  != htf_bm_org[1]
new_bull_m  = htf_um_org  != htf_um_org[1]

// --- Proximity alerts for the 10 dedicated HTF FVG zones ---
// Same hysteresis armed/disarmed idea as the 8 structural POI alerts above:
// fires once on approach, re-arms once price moves back beyond
// near_reset_dist, and also re-arms on a fresh new-edge (a new imbalance
// instance even if it reuses the same zone slot).
f_zone_alert(bool cond_near, bool cond_far, bool new_edge, bool armed_in) =>
    bool armed = armed_in
    if new_edge
        armed := true
    fire = false
    if cond_near and armed
        fire  := true
        armed := false
    if cond_far
        armed := true
    [armed, fire]

var bool htf_b1h_armed = true
var bool htf_u1h_armed = true
var bool htf_b4h_armed = true
var bool htf_u4h_armed = true
var bool htf_bd_armed  = true
var bool htf_ud_armed  = true
var bool htf_bw_armed  = true
var bool htf_uw_armed  = true
var bool htf_bm_armed  = true
var bool htf_um_armed  = true

[tmp_b1h_armed, fire_b1h] = f_zone_alert(use_near_alert and htf_bear_1h_ok and f_near(htf_b1h_px), f_far(htf_b1h_px), new_bear_1h, htf_b1h_armed)
htf_b1h_armed := tmp_b1h_armed
[tmp_u1h_armed, fire_u1h] = f_zone_alert(use_near_alert and htf_bull_1h_ok and f_near(htf_u1h_px), f_far(htf_u1h_px), new_bull_1h, htf_u1h_armed)
htf_u1h_armed := tmp_u1h_armed
[tmp_b4h_armed, fire_b4h] = f_zone_alert(use_near_alert and htf_bear_4h_ok and f_near(htf_b4h_px), f_far(htf_b4h_px), new_bear_4h, htf_b4h_armed)
htf_b4h_armed := tmp_b4h_armed
[tmp_u4h_armed, fire_u4h] = f_zone_alert(use_near_alert and htf_bull_4h_ok and f_near(htf_u4h_px), f_far(htf_u4h_px), new_bull_4h, htf_u4h_armed)
htf_u4h_armed := tmp_u4h_armed
[tmp_bd_armed, fire_bd] = f_zone_alert(use_near_alert and htf_bear_d_ok and f_near(htf_bd_px), f_far(htf_bd_px), new_bear_d, htf_bd_armed)
htf_bd_armed := tmp_bd_armed
[tmp_ud_armed, fire_ud] = f_zone_alert(use_near_alert and htf_bull_d_ok and f_near(htf_ud_px), f_far(htf_ud_px), new_bull_d, htf_ud_armed)
htf_ud_armed := tmp_ud_armed
[tmp_bw_armed, fire_bw] = f_zone_alert(use_near_alert and htf_bear_w_ok and f_near(htf_bw_px), f_far(htf_bw_px), new_bear_w, htf_bw_armed)
htf_bw_armed := tmp_bw_armed
[tmp_uw_armed, fire_uw] = f_zone_alert(use_near_alert and htf_bull_w_ok and f_near(htf_uw_px), f_far(htf_uw_px), new_bull_w, htf_uw_armed)
htf_uw_armed := tmp_uw_armed
[tmp_bm_armed, fire_bm] = f_zone_alert(use_near_alert and htf_bear_m_ok and f_near(htf_bm_px), f_far(htf_bm_px), new_bear_m, htf_bm_armed)
htf_bm_armed := tmp_bm_armed
[tmp_um_armed, fire_um] = f_zone_alert(use_near_alert and htf_bull_m_ok and f_near(htf_um_px), f_far(htf_um_px), new_bull_m, htf_um_armed)
htf_um_armed := tmp_um_armed

if fire_b1h
    alert("Price approaching 1H FVG Bear - " + str.tostring(htf_b1h_px, "#.#####"), alert.freq_once_per_bar)
if fire_u1h
    alert("Price approaching 1H FVG Bull - " + str.tostring(htf_u1h_px, "#.#####"), alert.freq_once_per_bar)
if fire_b4h
    alert("Price approaching 4H FVG Bear - " + str.tostring(htf_b4h_px, "#.#####"), alert.freq_once_per_bar)
if fire_u4h
    alert("Price approaching 4H FVG Bull - " + str.tostring(htf_u4h_px, "#.#####"), alert.freq_once_per_bar)
if fire_bd
    alert("Price approaching D FVG Bear - " + str.tostring(htf_bd_px, "#.#####"), alert.freq_once_per_bar)
if fire_ud
    alert("Price approaching D FVG Bull - " + str.tostring(htf_ud_px, "#.#####"), alert.freq_once_per_bar)
if fire_bw
    alert("Price approaching W FVG Bear - " + str.tostring(htf_bw_px, "#.#####"), alert.freq_once_per_bar)
if fire_uw
    alert("Price approaching W FVG Bull - " + str.tostring(htf_uw_px, "#.#####"), alert.freq_once_per_bar)
if fire_bm
    alert("Price approaching MN FVG Bear - " + str.tostring(htf_bm_px, "#.#####"), alert.freq_once_per_bar)
if fire_um
    alert("Price approaching MN FVG Bull - " + str.tostring(htf_um_px, "#.#####"), alert.freq_once_per_bar)



// The POI lines are rebuilt from scratch, and only the last bar's set is ever
// visible — so they are built ONLY on the last bar (every realtime tick is
// the last bar). Building them on every historical bar was the single
// biggest cost of the script: the whole merge/sort/draw pass thousands of
// times for drawings that were deleted on the very next bar.
if render_bar
    n_ml = array.size(managed_poi_lines)
    if n_ml > 0
        for i = 0 to n_ml - 1
            line.delete(array.get(managed_poi_lines, i))
    array.clear(managed_poi_lines)
    n_mlb = array.size(managed_poi_labels)
    if n_mlb > 0
        for i = 0 to n_mlb - 1
            label.delete(array.get(managed_poi_labels, i))
    array.clear(managed_poi_labels)

// A swept level that triggered the CURRENT active sweep->MSS->entry cycle
// turns green instead of just disappearing, and stays visible
// regardless of distance (it's part of the active setup, not just a
// passive structural level) until the cycle resets to state 0 — the
// green color are the only things that track the active cycle now.
//
// Any swept level FREEZES THE INSTANT IT'S HIT, active cycle or not: the line
// stops right at the liquidating candle (extend=none, x2 = the liquidation
// time) instead of continuing to extend across the candles that follow while
// the trade plays out, which is what was overlapping the CE line and price
// action in the screenshot. Still shown only if it was hit in the CURRENT
// session (clock-based key, cur_sess_key) — once that session ends it's gone.
f_poi_entry(float lvl, bool swept, int sw_t, int sw_s, string nm) =>
    is_active = swept and lvl == active_sweep_px and state != 0
    same_sess = swept and not na(sw_s) and sw_s == cur_sess_key
    show      = (poi_in_rng(lvl) and not swept) or same_sess
    nm2       = nm
    end_t     = same_sess and not na(sw_t) ? sw_t : time
    [show, nm2, is_active, same_sess, end_t]

// One flat color for every POI line and one for every imbalance line — no
// more per-level palette. poi_line_col: the line itself, always solid,
// opaque. imb_line_col: the imbalance line at 10% transparency; its label
// text is always the fully-opaque version of the same color regardless of
// the line's transparency, per the "10% transparent line, 100% solid text"
// spec. Green (active sweep) still overrides both, since that's a
// functional signal, not a decorative choice.
poi_line_solid = color.new(poi_line_col, 0)
imb_line_faded = color.new(imb_line_col, imb_line_transp)
imb_text_solid = color.new(imb_line_col, 0)
active_col      = color.new(color.lime, 10)

if show_levels and render_bar
    poi_px  = array.new_float(0)
    poi_nm  = array.new_string(0)
    poi_cl  = array.new<color>(0)   // line color
    poi_tx  = array.new<color>(0)   // text color (always opaque)
    poi_pr  = array.new_int(0)
    poi_bar = array.new_int(0)
    poi_ext = array.new_bool(0)     // true = extend.right ("live"), false = frozen at poi_end
    poi_end = array.new_int(0)      // x2 (time) — "now" when live, liquidation time when frozen
    poi_hi  = array.new_bool(0)     // true = zone marks a HIGH/max (label above line), false = LOW/min (label below)

    if show_levels and use_pdhl
        [show_pdh, nm_pdh, act_pdh, frz_pdh, end_pdh] = f_poi_entry(pdh, pdh_swept, pdh_swept_t, pdh_swept_s, "PDH")
        if show_pdh
            array.push(poi_px, pdh)
            array.push(poi_nm, nm_pdh)
            array.push(poi_cl, act_pdh ? active_col : poi_line_solid)
            array.push(poi_tx, act_pdh ? active_col : poi_line_solid)
            array.push(poi_pr, 10)
            array.push(poi_bar, nz(pdh_bar, time))
            array.push(poi_ext, not frz_pdh)
            array.push(poi_end, end_pdh)
            array.push(poi_hi, true)
        [show_pdl, nm_pdl, act_pdl, frz_pdl, end_pdl] = f_poi_entry(pdl, pdl_swept, pdl_swept_t, pdl_swept_s, "PDL")
        if show_pdl
            array.push(poi_px, pdl)
            array.push(poi_nm, nm_pdl)
            array.push(poi_cl, act_pdl ? active_col : poi_line_solid)
            array.push(poi_tx, act_pdl ? active_col : poi_line_solid)
            array.push(poi_pr, 11)
            array.push(poi_bar, nz(pdl_bar, time))
            array.push(poi_ext, not frz_pdl)
            array.push(poi_end, end_pdl)
            array.push(poi_hi, false)
    if show_levels and use_pwhl
        [show_pwh, nm_pwh, act_pwh, frz_pwh, end_pwh] = f_poi_entry(pwh, pwh_swept, pwh_swept_t, pwh_swept_s, "PWH")
        if show_pwh
            array.push(poi_px, pwh)
            array.push(poi_nm, nm_pwh)
            array.push(poi_cl, act_pwh ? active_col : poi_line_solid)
            array.push(poi_tx, act_pwh ? active_col : poi_line_solid)
            array.push(poi_pr, 20)
            array.push(poi_bar, nz(pwh_bar, time))
            array.push(poi_ext, not frz_pwh)
            array.push(poi_end, end_pwh)
            array.push(poi_hi, true)
        [show_pwl, nm_pwl, act_pwl, frz_pwl, end_pwl] = f_poi_entry(pwl, pwl_swept, pwl_swept_t, pwl_swept_s, "PWL")
        if show_pwl
            array.push(poi_px, pwl)
            array.push(poi_nm, nm_pwl)
            array.push(poi_cl, act_pwl ? active_col : poi_line_solid)
            array.push(poi_tx, act_pwl ? active_col : poi_line_solid)
            array.push(poi_pr, 21)
            array.push(poi_bar, nz(pwl_bar, time))
            array.push(poi_ext, not frz_pwl)
            array.push(poi_end, end_pwl)
            array.push(poi_hi, false)
    if show_levels and use_eql
        // Every still-live (unswept) equal-high/low within visibility
        // distance shows — no single-slot overwrite, mirrors the HTF FVG
        // live-entry loop exactly.
        n_eqh = array.size(eqh_arr)
        if n_eqh > 0
            for i = 0 to n_eqh - 1
                px = array.get(eqh_arr, i)
                if poi_in_rng(px) and f_age_ok(array.get(eqh_bar_arr, i), age_eq_d)
                    array.push(poi_px, px)
                    array.push(poi_nm, "EQH")
                    array.push(poi_cl, poi_line_solid)
                    array.push(poi_tx, poi_line_solid)
                    array.push(poi_pr, 40)
                    array.push(poi_bar, array.get(eqh_bar_arr, i))
                    array.push(poi_ext, true)
                    array.push(poi_end, time)
                    array.push(poi_hi, true)
        n_eql = array.size(eql_arr)
        if n_eql > 0
            for i = 0 to n_eql - 1
                px = array.get(eql_arr, i)
                if poi_in_rng(px) and f_age_ok(array.get(eql_bar_arr, i), age_eq_d)
                    array.push(poi_px, px)
                    array.push(poi_nm, "EQL")
                    array.push(poi_cl, poi_line_solid)
                    array.push(poi_tx, poi_line_solid)
                    array.push(poi_pr, 41)
                    array.push(poi_bar, array.get(eql_bar_arr, i))
                    array.push(poi_ext, true)
                    array.push(poi_end, time)
                    array.push(poi_hi, false)
        // Swept-record: the most recently swept EQH/EQL, frozen for the
        // rest of this session — same lifecycle every other POI type has,
        // same pattern already used for the HTF-imbalance swept records.
        [show_eqh_sw, nm_eqh_sw, act_eqh_sw, frz_eqh_sw, end_eqh_sw] = f_poi_entry(eqh_swept_px, not na(eqh_swept_px), eqh_swept_t, eqh_swept_s, "EQH")
        if show_eqh_sw
            array.push(poi_px, eqh_swept_px)
            array.push(poi_nm, nm_eqh_sw)
            array.push(poi_cl, act_eqh_sw ? active_col : poi_line_solid)
            array.push(poi_tx, act_eqh_sw ? active_col : poi_line_solid)
            array.push(poi_pr, 40)
            array.push(poi_bar, nz(eqh_swept_o, nz(eqh_swept_t, time)))
            array.push(poi_ext, not frz_eqh_sw)
            array.push(poi_end, end_eqh_sw)
            array.push(poi_hi, true)
        [show_eql_sw, nm_eql_sw, act_eql_sw, frz_eql_sw, end_eql_sw] = f_poi_entry(eql_swept_px, not na(eql_swept_px), eql_swept_t, eql_swept_s, "EQL")
        if show_eql_sw
            array.push(poi_px, eql_swept_px)
            array.push(poi_nm, nm_eql_sw)
            array.push(poi_cl, act_eql_sw ? active_col : poi_line_solid)
            array.push(poi_tx, act_eql_sw ? active_col : poi_line_solid)
            array.push(poi_pr, 41)
            array.push(poi_bar, nz(eql_swept_o, nz(eql_swept_t, time)))
            array.push(poi_ext, not frz_eql_sw)
            array.push(poi_end, end_eql_sw)
            array.push(poi_hi, false)

    // --- HTF FVG imbalance zones (1H..MN), same merge system as POI levels ---
    // Every unmitigated gap within visibility distance shows — no cap on how
    // many can be tracked per TF, only on how far from price one still draws.
    if show_levels and use_htf_1h
        n_b1h = array.size(htf_b1h_near_arr)
        if n_b1h > 0
            b1h_outer = f_recompute_outer(htf_b1h_near_arr, htf_b1h_far_arr, htf_b1h_org_arr, true, 3 * 3600000)
            for i = 0 to n_b1h - 1
                px = array.get(htf_b1h_near_arr, i)
                if f_imb_in_rng(px) and array.get(b1h_outer, i) and f_age_ok(array.get(htf_b1h_org_arr, i), age_1h_d)
                    array.push(poi_px, px)
                    array.push(poi_nm, "1H")
                    array.push(poi_cl, imb_line_faded)
                    array.push(poi_tx, imb_text_solid)
                    array.push(poi_pr, 58)
                    array.push(poi_bar, array.get(htf_b1h_cre_arr, i))
                    array.push(poi_ext, true)
                    array.push(poi_end, time)
                    array.push(poi_hi, true)
        n_u1h = array.size(htf_u1h_near_arr)
        if n_u1h > 0
            u1h_outer = f_recompute_outer(htf_u1h_near_arr, htf_u1h_far_arr, htf_u1h_org_arr, false, 3 * 3600000)
            for i = 0 to n_u1h - 1
                px = array.get(htf_u1h_near_arr, i)
                if f_imb_in_rng(px) and array.get(u1h_outer, i) and f_age_ok(array.get(htf_u1h_org_arr, i), age_1h_d)
                    array.push(poi_px, px)
                    array.push(poi_nm, "1H")
                    array.push(poi_cl, imb_line_faded)
                    array.push(poi_tx, imb_text_solid)
                    array.push(poi_pr, 59)
                    array.push(poi_bar, array.get(htf_u1h_cre_arr, i))
                    array.push(poi_ext, true)
                    array.push(poi_end, time)
                    array.push(poi_hi, false)
        // Swept-record: the most recently touched 1H gap on each side,
        // frozen for the rest of this session — same lifecycle every other
        // POI type already gets, previously missing entirely for HTF gaps.
        [show_b1h_sw, nm_b1h_sw, act_b1h_sw, frz_b1h_sw, end_b1h_sw] = f_poi_entry(htf_b1h_swept_px, not na(htf_b1h_swept_px), htf_b1h_swept_t, htf_b1h_swept_s, "1H")
        if show_b1h_sw
            array.push(poi_px, htf_b1h_swept_px)
            array.push(poi_nm, nm_b1h_sw)
            array.push(poi_cl, act_b1h_sw ? active_col : imb_line_faded)
            array.push(poi_tx, act_b1h_sw ? active_col : imb_text_solid)
            array.push(poi_pr, 58)
            array.push(poi_bar, nz(htf_b1h_swept_o, nz(htf_b1h_swept_t, time)))
            array.push(poi_ext, not frz_b1h_sw)
            array.push(poi_end, end_b1h_sw)
            array.push(poi_hi, true)
        [show_u1h_sw, nm_u1h_sw, act_u1h_sw, frz_u1h_sw, end_u1h_sw] = f_poi_entry(htf_u1h_swept_px, not na(htf_u1h_swept_px), htf_u1h_swept_t, htf_u1h_swept_s, "1H")
        if show_u1h_sw
            array.push(poi_px, htf_u1h_swept_px)
            array.push(poi_nm, nm_u1h_sw)
            array.push(poi_cl, act_u1h_sw ? active_col : imb_line_faded)
            array.push(poi_tx, act_u1h_sw ? active_col : imb_text_solid)
            array.push(poi_pr, 59)
            array.push(poi_bar, nz(htf_u1h_swept_o, nz(htf_u1h_swept_t, time)))
            array.push(poi_ext, not frz_u1h_sw)
            array.push(poi_end, end_u1h_sw)
            array.push(poi_hi, false)
    if show_levels and use_htf_4h
        n_b4h = array.size(htf_b4h_near_arr)
        if n_b4h > 0
            b4h_outer = f_recompute_outer(htf_b4h_near_arr, htf_b4h_far_arr, htf_b4h_org_arr, true, 3 * 14400000)
            for i = 0 to n_b4h - 1
                px = array.get(htf_b4h_near_arr, i)
                if f_imb_in_rng(px) and array.get(b4h_outer, i) and f_age_ok(array.get(htf_b4h_org_arr, i), age_4h_d)
                    array.push(poi_px, px)
                    array.push(poi_nm, "4H")
                    array.push(poi_cl, imb_line_faded)
                    array.push(poi_tx, imb_text_solid)
                    array.push(poi_pr, 56)
                    array.push(poi_bar, array.get(htf_b4h_cre_arr, i))
                    array.push(poi_ext, true)
                    array.push(poi_end, time)
                    array.push(poi_hi, true)
        n_u4h = array.size(htf_u4h_near_arr)
        if n_u4h > 0
            u4h_outer = f_recompute_outer(htf_u4h_near_arr, htf_u4h_far_arr, htf_u4h_org_arr, false, 3 * 14400000)
            for i = 0 to n_u4h - 1
                px = array.get(htf_u4h_near_arr, i)
                if f_imb_in_rng(px) and array.get(u4h_outer, i) and f_age_ok(array.get(htf_u4h_org_arr, i), age_4h_d)
                    array.push(poi_px, px)
                    array.push(poi_nm, "4H")
                    array.push(poi_cl, imb_line_faded)
                    array.push(poi_tx, imb_text_solid)
                    array.push(poi_pr, 57)
                    array.push(poi_bar, array.get(htf_u4h_cre_arr, i))
                    array.push(poi_ext, true)
                    array.push(poi_end, time)
                    array.push(poi_hi, false)
        [show_b4h_sw, nm_b4h_sw, act_b4h_sw, frz_b4h_sw, end_b4h_sw] = f_poi_entry(htf_b4h_swept_px, not na(htf_b4h_swept_px), htf_b4h_swept_t, htf_b4h_swept_s, "4H")
        if show_b4h_sw
            array.push(poi_px, htf_b4h_swept_px)
            array.push(poi_nm, nm_b4h_sw)
            array.push(poi_cl, act_b4h_sw ? active_col : imb_line_faded)
            array.push(poi_tx, act_b4h_sw ? active_col : imb_text_solid)
            array.push(poi_pr, 56)
            array.push(poi_bar, nz(htf_b4h_swept_o, nz(htf_b4h_swept_t, time)))
            array.push(poi_ext, not frz_b4h_sw)
            array.push(poi_end, end_b4h_sw)
            array.push(poi_hi, true)
        [show_u4h_sw, nm_u4h_sw, act_u4h_sw, frz_u4h_sw, end_u4h_sw] = f_poi_entry(htf_u4h_swept_px, not na(htf_u4h_swept_px), htf_u4h_swept_t, htf_u4h_swept_s, "4H")
        if show_u4h_sw
            array.push(poi_px, htf_u4h_swept_px)
            array.push(poi_nm, nm_u4h_sw)
            array.push(poi_cl, act_u4h_sw ? active_col : imb_line_faded)
            array.push(poi_tx, act_u4h_sw ? active_col : imb_text_solid)
            array.push(poi_pr, 57)
            array.push(poi_bar, nz(htf_u4h_swept_o, nz(htf_u4h_swept_t, time)))
            array.push(poi_ext, not frz_u4h_sw)
            array.push(poi_end, end_u4h_sw)
            array.push(poi_hi, false)
    if show_levels and use_htf_d
        n_bd = array.size(htf_bd_near_arr)
        if n_bd > 0
            bd_outer = f_recompute_outer(htf_bd_near_arr, htf_bd_far_arr, htf_bd_org_arr, true, 4 * 86400000)
            for i = 0 to n_bd - 1
                px = array.get(htf_bd_near_arr, i)
                if f_imb_in_rng(px) and array.get(bd_outer, i)
                    array.push(poi_px, px)
                    array.push(poi_nm, "D")
                    array.push(poi_cl, imb_line_faded)
                    array.push(poi_tx, imb_text_solid)
                    array.push(poi_pr, 54)
                    array.push(poi_bar, array.get(htf_bd_cre_arr, i))
                    array.push(poi_ext, true)
                    array.push(poi_end, time)
                    array.push(poi_hi, true)
        n_ud = array.size(htf_ud_near_arr)
        if n_ud > 0
            ud_outer = f_recompute_outer(htf_ud_near_arr, htf_ud_far_arr, htf_ud_org_arr, false, 4 * 86400000)
            for i = 0 to n_ud - 1
                px = array.get(htf_ud_near_arr, i)
                if f_imb_in_rng(px) and array.get(ud_outer, i)
                    array.push(poi_px, px)
                    array.push(poi_nm, "D")
                    array.push(poi_cl, imb_line_faded)
                    array.push(poi_tx, imb_text_solid)
                    array.push(poi_pr, 55)
                    array.push(poi_bar, array.get(htf_ud_cre_arr, i))
                    array.push(poi_ext, true)
                    array.push(poi_end, time)
                    array.push(poi_hi, false)
        [show_bd_sw, nm_bd_sw, act_bd_sw, frz_bd_sw, end_bd_sw] = f_poi_entry(htf_bd_swept_px, not na(htf_bd_swept_px), htf_bd_swept_t, htf_bd_swept_s, "D")
        if show_bd_sw
            array.push(poi_px, htf_bd_swept_px)
            array.push(poi_nm, nm_bd_sw)
            array.push(poi_cl, act_bd_sw ? active_col : imb_line_faded)
            array.push(poi_tx, act_bd_sw ? active_col : imb_text_solid)
            array.push(poi_pr, 54)
            array.push(poi_bar, nz(htf_bd_swept_o, nz(htf_bd_swept_t, time)))
            array.push(poi_ext, not frz_bd_sw)
            array.push(poi_end, end_bd_sw)
            array.push(poi_hi, true)
        [show_ud_sw, nm_ud_sw, act_ud_sw, frz_ud_sw, end_ud_sw] = f_poi_entry(htf_ud_swept_px, not na(htf_ud_swept_px), htf_ud_swept_t, htf_ud_swept_s, "D")
        if show_ud_sw
            array.push(poi_px, htf_ud_swept_px)
            array.push(poi_nm, nm_ud_sw)
            array.push(poi_cl, act_ud_sw ? active_col : imb_line_faded)
            array.push(poi_tx, act_ud_sw ? active_col : imb_text_solid)
            array.push(poi_pr, 55)
            array.push(poi_bar, nz(htf_ud_swept_o, nz(htf_ud_swept_t, time)))
            array.push(poi_ext, not frz_ud_sw)
            array.push(poi_end, end_ud_sw)
            array.push(poi_hi, false)
    if show_levels and use_htf_w
        n_bw = array.size(htf_bw_near_arr)
        if n_bw > 0
            bw_outer = f_recompute_outer(htf_bw_near_arr, htf_bw_far_arr, htf_bw_org_arr, true, 3 * 604800000)
            for i = 0 to n_bw - 1
                px = array.get(htf_bw_near_arr, i)
                if f_imb_in_rng(px) and array.get(bw_outer, i)
                    array.push(poi_px, px)
                    array.push(poi_nm, "W")
                    array.push(poi_cl, imb_line_faded)
                    array.push(poi_tx, imb_text_solid)
                    array.push(poi_pr, 52)
                    array.push(poi_bar, array.get(htf_bw_cre_arr, i))
                    array.push(poi_ext, true)
                    array.push(poi_end, time)
                    array.push(poi_hi, true)
        n_uw = array.size(htf_uw_near_arr)
        if n_uw > 0
            uw_outer = f_recompute_outer(htf_uw_near_arr, htf_uw_far_arr, htf_uw_org_arr, false, 3 * 604800000)
            for i = 0 to n_uw - 1
                px = array.get(htf_uw_near_arr, i)
                if f_imb_in_rng(px) and array.get(uw_outer, i)
                    array.push(poi_px, px)
                    array.push(poi_nm, "W")
                    array.push(poi_cl, imb_line_faded)
                    array.push(poi_tx, imb_text_solid)
                    array.push(poi_pr, 53)
                    array.push(poi_bar, array.get(htf_uw_cre_arr, i))
                    array.push(poi_ext, true)
                    array.push(poi_end, time)
                    array.push(poi_hi, false)
        [show_bw_sw, nm_bw_sw, act_bw_sw, frz_bw_sw, end_bw_sw] = f_poi_entry(htf_bw_swept_px, not na(htf_bw_swept_px), htf_bw_swept_t, htf_bw_swept_s, "W")
        if show_bw_sw
            array.push(poi_px, htf_bw_swept_px)
            array.push(poi_nm, nm_bw_sw)
            array.push(poi_cl, act_bw_sw ? active_col : imb_line_faded)
            array.push(poi_tx, act_bw_sw ? active_col : imb_text_solid)
            array.push(poi_pr, 52)
            array.push(poi_bar, nz(htf_bw_swept_o, nz(htf_bw_swept_t, time)))
            array.push(poi_ext, not frz_bw_sw)
            array.push(poi_end, end_bw_sw)
            array.push(poi_hi, true)
        [show_uw_sw, nm_uw_sw, act_uw_sw, frz_uw_sw, end_uw_sw] = f_poi_entry(htf_uw_swept_px, not na(htf_uw_swept_px), htf_uw_swept_t, htf_uw_swept_s, "W")
        if show_uw_sw
            array.push(poi_px, htf_uw_swept_px)
            array.push(poi_nm, nm_uw_sw)
            array.push(poi_cl, act_uw_sw ? active_col : imb_line_faded)
            array.push(poi_tx, act_uw_sw ? active_col : imb_text_solid)
            array.push(poi_pr, 53)
            array.push(poi_bar, nz(htf_uw_swept_o, nz(htf_uw_swept_t, time)))
            array.push(poi_ext, not frz_uw_sw)
            array.push(poi_end, end_uw_sw)
            array.push(poi_hi, false)
    if show_levels and use_htf_m
        n_bm = array.size(htf_bm_near_arr)
        if n_bm > 0
            bm_outer = f_recompute_outer(htf_bm_near_arr, htf_bm_far_arr, htf_bm_org_arr, true, 3 * 2678400000)
            for i = 0 to n_bm - 1
                px = array.get(htf_bm_near_arr, i)
                if f_imb_in_rng(px) and array.get(bm_outer, i)
                    array.push(poi_px, px)
                    array.push(poi_nm, "MN")
                    array.push(poi_cl, imb_line_faded)
                    array.push(poi_tx, imb_text_solid)
                    array.push(poi_pr, 50)
                    array.push(poi_bar, array.get(htf_bm_cre_arr, i))
                    array.push(poi_ext, true)
                    array.push(poi_end, time)
                    array.push(poi_hi, true)
        n_um = array.size(htf_um_near_arr)
        if n_um > 0
            um_outer = f_recompute_outer(htf_um_near_arr, htf_um_far_arr, htf_um_org_arr, false, 3 * 2678400000)
            for i = 0 to n_um - 1
                px = array.get(htf_um_near_arr, i)
                if f_imb_in_rng(px) and array.get(um_outer, i)
                    array.push(poi_px, px)
                    array.push(poi_nm, "MN")
                    array.push(poi_cl, imb_line_faded)
                    array.push(poi_tx, imb_text_solid)
                    array.push(poi_pr, 51)
                    array.push(poi_bar, array.get(htf_um_cre_arr, i))
                    array.push(poi_ext, true)
                    array.push(poi_end, time)
                    array.push(poi_hi, false)
        [show_bm_sw, nm_bm_sw, act_bm_sw, frz_bm_sw, end_bm_sw] = f_poi_entry(htf_bm_swept_px, not na(htf_bm_swept_px), htf_bm_swept_t, htf_bm_swept_s, "MN")
        if show_bm_sw
            array.push(poi_px, htf_bm_swept_px)
            array.push(poi_nm, nm_bm_sw)
            array.push(poi_cl, act_bm_sw ? active_col : imb_line_faded)
            array.push(poi_tx, act_bm_sw ? active_col : imb_text_solid)
            array.push(poi_pr, 50)
            array.push(poi_bar, nz(htf_bm_swept_o, nz(htf_bm_swept_t, time)))
            array.push(poi_ext, not frz_bm_sw)
            array.push(poi_end, end_bm_sw)
            array.push(poi_hi, true)
        [show_um_sw, nm_um_sw, act_um_sw, frz_um_sw, end_um_sw] = f_poi_entry(htf_um_swept_px, not na(htf_um_swept_px), htf_um_swept_t, htf_um_swept_s, "MN")
        if show_um_sw
            array.push(poi_px, htf_um_swept_px)
            array.push(poi_nm, nm_um_sw)
            array.push(poi_cl, act_um_sw ? active_col : imb_line_faded)
            array.push(poi_tx, act_um_sw ? active_col : imb_text_solid)
            array.push(poi_pr, 51)
            array.push(poi_bar, nz(htf_um_swept_o, nz(htf_um_swept_t, time)))
            array.push(poi_ext, not frz_um_sw)
            array.push(poi_end, end_um_sw)
            array.push(poi_hi, false)


    n_poi = array.size(poi_px)
    if n_poi > 0
        sorted_idx = array.sort_indices(poi_px, order.ascending)
        used_flags = array.new_bool(n_poi, false)
        // merged groups, drawn after the per-side cap below
        gr_px  = array.new_float(0)
        gr_nm  = array.new_string(0)
        gr_cl  = array.new_color(0)
        gr_tx  = array.new_color(0)
        gr_bar = array.new_int(0)
        gr_ext = array.new_bool(0)
        gr_end = array.new_int(0)
        gr_hi  = array.new_bool(0)
        gr_d   = array.new_float(0)

        for ii = 0 to n_poi - 1
            si = array.get(sorted_idx, ii)
            if array.get(used_flags, si)
                continue
            g_px  = array.get(poi_px, si)
            g_nm  = array.get(poi_nm, si)
            g_cl  = array.get(poi_cl, si)
            g_tx  = array.get(poi_tx, si)
            g_pr  = array.get(poi_pr, si)
            g_bar = array.get(poi_bar, si)
            g_ext = array.get(poi_ext, si)
            g_end = array.get(poi_end, si)
            g_hi  = array.get(poi_hi, si)
            base_px = g_px
            array.set(used_flags, si, true)

            // Only members in the SAME state merge: live with live, swept
            // (frozen) with swept. A swept PDH next to a live D FVG used to
            // become one extending line that ran through price; now each
            // keeps its own line. The line sits at the winning (highest
            // priority) member's own price.
            jj = ii + 1
            while jj <= n_poi - 1
                sj  = array.get(sorted_idx, jj)
                pj  = array.get(poi_px, sj)
                if pj - base_px > merge_tol
                    break
                if not array.get(used_flags, sj) and array.get(poi_ext, sj) == g_ext
                    prj = array.get(poi_pr, sj)
                    nmj = array.get(poi_nm, sj)
                    has_nm = str.contains(" · " + g_nm + " · ", " · " + nmj + " · ")
                    if prj < g_pr
                        g_nm  := has_nm ? g_nm : nmj + " · " + g_nm
                        g_px  := pj
                        g_cl  := array.get(poi_cl, sj)
                        g_tx  := array.get(poi_tx, sj)
                        g_pr  := prj
                        g_bar := array.get(poi_bar, sj)
                        g_end := array.get(poi_end, sj)
                        g_hi  := array.get(poi_hi, sj)
                    else if not has_nm
                        g_nm := g_nm + " · " + nmj
                    array.set(used_flags, sj, true)
                jj := jj + 1

            if g_ext
                g_end := time
            array.push(gr_px, g_px)
            array.push(gr_nm, g_nm)
            array.push(gr_cl, g_cl)
            array.push(gr_tx, g_tx)
            array.push(gr_bar, g_bar)
            array.push(gr_ext, g_ext)
            array.push(gr_end, g_end)
            array.push(gr_hi, g_hi)
            array.push(gr_d, math.abs(g_px - close))

        // Per-side cap: only the vis_max_side nearest LIVE lines above
        // price and below price are drawn. Frozen (swept this session)
        // lines always draw and don't count.
        n_gr = array.size(gr_px)
        if n_gr > 0
            by_dist = array.sort_indices(gr_d, order.ascending)
            int n_up = 0
            int n_dn = 0
            for k = 0 to n_gr - 1
                gi    = array.get(by_dist, k)
                d_px  = array.get(gr_px, gi)
                d_ext = array.get(gr_ext, gi)
                bool draw = true
                if d_ext
                    if d_px >= close
                        n_up += 1
                        draw := n_up <= vis_max_side
                    else
                        n_dn += 1
                        draw := n_dn <= vis_max_side
                if draw
                    // xloc.bar_time: bar-index x1 has a "too far from current
                    // bar" limit on long-lived zones. Never a vertical line:
                    // x1 is clamped to <= now and x2 is always > x1, and every
                    // line is horizontal (y1 == y2).
                    x1 = math.min(array.get(gr_bar, gi), time)
                    x2 = math.max(array.get(gr_end, gi), x1 + 1)
                    d_hi = array.get(gr_hi, gi)
                    new_l  = line.new(x1, d_px, x2, d_px, xloc = xloc.bar_time, extend = d_ext ? extend.right : extend.none, color = array.get(gr_cl, gi), style = line.style_solid, width = 1)
                    // Live lines: the label sits on the line a few candles to
                    // the RIGHT of the last candle (the chart's right margin),
                    // never on top of price. Frozen (swept) lines: the label
                    // ends where the line ends.
                    lb_x   = d_ext ? time + (lbl_off_bars + 1) * chart_sec * 1000 : x2
                    lb_sty = d_ext ? (d_hi ? label.style_label_lower_left : label.style_label_upper_left) : (d_hi ? label.style_label_lower_right : label.style_label_upper_right)
                    new_lb = label.new(lb_x, d_px, array.get(gr_nm, gi), xloc = xloc.bar_time, style = lb_sty, color = color.new(color.black, 100), textcolor = array.get(gr_tx, gi), size = size.small)
                    array.push(managed_poi_lines,  new_l)
                    array.push(managed_poi_labels, new_lb)

// Sweep markers — the bar this evaluates on IS the candle that crossed the
// level, so no offset is needed any more.
plotshape(show_sweep and any_hs, title = "Sweep HIGH", style = shape.triangledown, location = location.abovebar, color = color.new(color.red,  0), size = size.tiny)
plotshape(show_sweep and any_ls, title = "Sweep LOW",  style = shape.triangleup,   location = location.belowbar, color = color.new(color.teal, 0), size = size.tiny)

// Structure break ("CE") is now a managed label (ce_lbl, created above at
// the bear_mss/bull_mss transition, cleared at every cycle reset) instead
// of a plotshape — only the current cycle's break stays visible, and only
// while the bot is actively hunting for an entry, not a permanent history.

// Entry markers: none from the script — TradingView already draws the order
// arrow on the entry candle (its letter/quantity text is a chart setting:
// Style > untick "Signal labels" and "Quantity").

// Default mode: if the break happened inside session hours, short_valid/
// long_valid already fired and reset state to 0 above — this only ever
// runs for a break still PENDING a session to open in. Bounded by the same
// mss_max_bars deadline used for the sweep-to-break hunt (measured from
// sweep_bar, not mss_bar), so it stays a single simple knob instead of a
// second input — a pending setup that runs the clock out without ever
// seeing a session is abandoned here. Stop-too-wide / size-rounded-to-zero
// rejection is the other, immediate way out, already handled by
// short_valid/long_valid being false forever after a session-open bar that
// still fails validation.
if not use_fvg_entry and (state == 3 or state == 4) and (bar_index - sweep_bar) > mss_max_bars
    state := 0
    active_sweep_px := na

// ---- Zone diagnostic panel (read-only) ----
f_dbg_cnt(array<float> near_arr, array<int> org_arr, int days) =>
    int n   = array.size(near_arr)
    int nin = 0
    int nol = 0
    if n > 0
        for i = 0 to n - 1
            if f_imb_in_rng(array.get(near_arr, i))
                nin += 1
                if not f_age_ok(array.get(org_arr, i), days)
                    nol += 1
    str.tostring(n) + " / " + str.tostring(nin) + " / " + str.tostring(nol)

var table dbg_tbl = table.new(position.bottom_left, 3, 16, bgcolor = color.new(color.black, 30), border_width = 1, border_color = color.gray)
if render_bar and show_zone_dbg
    table.cell(dbg_tbl, 0, 0, "TF " + timeframe.period + "  px " + str.tostring(close, "#.#####"), text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 1, 0, "dist " + str.tostring(max_poi_dist, "#.#####") + "  adr " + str.tostring(vis_adr, "#.#####"), text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 2, 0, "sess " + str.tostring(cur_sess_key) + "  lines " + str.tostring(array.size(managed_poi_lines)), text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 0, 1, "zona (n / en rango / viejas)", text_color = color.gray, text_size = size.small)
    table.cell(dbg_tbl, 1, 1, "bear", text_color = color.gray, text_size = size.small)
    table.cell(dbg_tbl, 2, 1, "bull", text_color = color.gray, text_size = size.small)
    table.cell(dbg_tbl, 0, 2, "1H", text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 1, 2, f_dbg_cnt(htf_b1h_near_arr, htf_b1h_org_arr, age_1h_d), text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 2, 2, f_dbg_cnt(htf_u1h_near_arr, htf_u1h_org_arr, age_1h_d), text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 0, 3, "4H", text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 1, 3, f_dbg_cnt(htf_b4h_near_arr, htf_b4h_org_arr, age_4h_d), text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 2, 3, f_dbg_cnt(htf_u4h_near_arr, htf_u4h_org_arr, age_4h_d), text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 0, 4, "D", text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 1, 4, f_dbg_cnt(htf_bd_near_arr, htf_bd_org_arr, 0), text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 2, 4, f_dbg_cnt(htf_ud_near_arr, htf_ud_org_arr, 0), text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 0, 5, "W", text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 1, 5, f_dbg_cnt(htf_bw_near_arr, htf_bw_org_arr, 0), text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 2, 5, f_dbg_cnt(htf_uw_near_arr, htf_uw_org_arr, 0), text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 0, 6, "MN", text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 1, 6, f_dbg_cnt(htf_bm_near_arr, htf_bm_org_arr, 0), text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 2, 6, f_dbg_cnt(htf_um_near_arr, htf_um_org_arr, 0), text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 0, 7, "EQH / EQL (n)", text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 1, 7, str.tostring(array.size(eqh_arr)), text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 2, 7, str.tostring(array.size(eql_arr)), text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 0, 8, "PDH / PDL", text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 1, 8, str.tostring(pdh, "#.#####") + (pdh_swept ? " SW " + str.tostring(pdh_swept_s) : ""), text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 2, 8, str.tostring(pdl, "#.#####") + (pdl_swept ? " SW " + str.tostring(pdl_swept_s) : ""), text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 0, 9, "PWH / PWL", text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 1, 9, str.tostring(pwh, "#.#####") + (pwh_swept ? " SW " + str.tostring(pwh_swept_s) : ""), text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 2, 9, str.tostring(pwl, "#.#####") + (pwl_swept ? " SW " + str.tostring(pwl_swept_s) : ""), text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 0, 10, "swept 1H b/u", text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 1, 10, str.tostring(htf_b1h_swept_px, "#.#####") + " " + str.tostring(htf_b1h_swept_s), text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 2, 10, str.tostring(htf_u1h_swept_px, "#.#####") + " " + str.tostring(htf_u1h_swept_s), text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 0, 11, "swept 4H b/u", text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 1, 11, str.tostring(htf_b4h_swept_px, "#.#####") + " " + str.tostring(htf_b4h_swept_s), text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 2, 11, str.tostring(htf_u4h_swept_px, "#.#####") + " " + str.tostring(htf_u4h_swept_s), text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 0, 12, "swept EQH / EQL", text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 1, 12, str.tostring(eqh_swept_px, "#.#####") + " " + str.tostring(eqh_swept_s), text_color = color.white, text_size = size.small)
    table.cell(dbg_tbl, 2, 12, str.tostring(eql_swept_px, "#.#####") + " " + str.tostring(eql_swept_s), text_color = color.white, text_size = size.small)

// =============================================================
// INFO TABLE  (top right)
// =============================================================

var table tbl = table.new(position.top_right, 2, 15, bgcolor = color.new(color.black, 75), border_width = 1, border_color = color.gray)

if render_bar and show_info_tbl
    table.cell(tbl, 0, 0, "Liquidity Algo", text_color = color.white, bgcolor = color.new(color.navy, 50), text_size = size.normal)
    table.cell(tbl, 1, 0, "",               text_color = color.white, bgcolor = color.new(color.navy, 50), text_size = size.normal)

    st_str = switch state
        0 => "IDLE"
        1 => "SWEPT DN"
        2 => "SWEPT UP"
        3 => "FVG SHORT"
        => "FVG LONG"

    st_col = switch
        state == 0               => color.gray
        state == 1 or state == 2 => color.orange
        state == 3               => color.red
        =>                          color.teal

    table.cell(tbl, 0, 1, "State",   text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 1, st_str,    text_color = st_col,     text_size = size.small)

    rsk_pct = str.tostring(f_risk(attempt) * 100, "#.##")
    rsk_str = str.tostring(attempt) + "/6 (" + rsk_pct + "%)"
    rsk_col = switch
        attempt == 1 => color.lime
        attempt <= 3 => color.yellow
        =>              color.red

    table.cell(tbl, 0, 2, "Attempt", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 2, rsk_str,   text_color = rsk_col,    text_size = size.small)

    td_str = str.tostring(trades_today) + "/" + str.tostring(max_day_tr)
    td_col = trades_today >= max_day_tr ? color.red : color.lime
    table.cell(tbl, 0, 3, "Trades Today", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 3, td_str,         text_color = td_col,     text_size = size.small)

    kz_str = switch
        in_london => "London"
        in_ny     => "New York"
        =>            "OFF"
    kz_col = in_kz ? color.lime : color.red
    table.cell(tbl, 0, 4, "Kill Zone", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 4, kz_str,      text_color = kz_col,     text_size = size.small)

    bias_str = switch
        htf_bear and not htf_bull => "BEAR"
        htf_bull and not htf_bear => "BULL"
        =>                           "NEUTRAL"
    bias_col = switch
        htf_bear and not htf_bull => color.red
        htf_bull and not htf_bear => color.teal
        =>                           color.gray
    table.cell(tbl, 0, 5, "HTF Bias", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 5, bias_str,   text_color = bias_col,   text_size = size.small)

    pdhl_val = not na(pdh) ? str.tostring(pdh, "#.#####") + "/" + str.tostring(pdl, "#.#####") : "--"
    table.cell(tbl, 0, 6, "PDH/PDL", text_color = color.gray,  text_size = size.small)
    table.cell(tbl, 1, 6, pdhl_val,  text_color = color.orange, text_size = size.small)

    pwhl_val = not na(pwh) ? str.tostring(pwh, "#.#####") + "/" + str.tostring(pwl, "#.#####") : "--"
    table.cell(tbl, 0, 7, "PWH/PWL", text_color = color.gray,  text_size = size.small)
    table.cell(tbl, 1, 7, pwhl_val,  text_color = color.maroon, text_size = size.small)

    fvg_active = (state == 3 or state == 4) and not na(fvg_top)
    fvg_val    = fvg_active ? str.tostring(fvg_top, "#.#####") + "/" + str.tostring(fvg_bot, "#.#####") : "--"
    table.cell(tbl, 0, 8, "FVG Zone", text_color = color.gray,  text_size = size.small)
    table.cell(tbl, 1, 8, fvg_val,    text_color = color.yellow, text_size = size.small)

    // Funnel diagnostics — if a count is stuck at 0, that's exactly where
    // setups are being cut off (no sweeps = HTF bias/kill zone too strict,
    // sweeps but no MSS = mss_max_bars too short, MSS but no FVG = gap too
    // small at the break, FVG but no entry = retest never happened / too
    // strict close-inside-FVG requirement).
    table.cell(tbl, 0, 9,  "Sweeps",   text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 9,  str.tostring(cnt_sweep), text_color = color.white, text_size = size.small)
    table.cell(tbl, 0, 10, "MSS Confirmed", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 10, str.tostring(cnt_mss),   text_color = color.white, text_size = size.small)
    table.cell(tbl, 0, 11, "FVGs Formed", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 11, str.tostring(cnt_fvg),   text_color = color.white, text_size = size.small)
    table.cell(tbl, 0, 12, "Entries", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 12, str.tostring(cnt_entry), text_color = color.lime,  text_size = size.small)

    lon_str = str.tostring(lon_session_trades) + "/" + str.tostring(sess_max_trades)
    lon_col = lon_session_trades >= sess_max_trades ? color.red : color.lime
    table.cell(tbl, 0, 13, "London Trades", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 13, lon_str, text_color = lon_col, text_size = size.small)

    ny_str = str.tostring(ny_session_trades) + "/" + str.tostring(sess_max_trades)
    ny_col = ny_session_trades >= sess_max_trades ? color.red : color.lime
    table.cell(tbl, 0, 14, "NY Trades", text_color = color.gray, text_size = size.small)
    table.cell(tbl, 1, 14, ny_str, text_color = ny_col, text_size = size.small)

// =============================================================
// STATS TABLE  (top left)
// =============================================================

var table stats = table.new(position.top_left, 2, 9, bgcolor = color.new(color.black, 75), border_width = 1, border_color = color.gray)

if render_bar and show_stats_tbl
    n_closed = strategy.closedtrades
    n_wins   = strategy.wintrades
    n_loss   = strategy.losstrades
    win_rate = n_closed > 0 ? (n_wins / n_closed) * 100.0 : 0.0
    avg_win  = n_wins > 0  ? strategy.grossprofit / n_wins : 0.0
    avg_loss = n_loss > 0  ? math.abs(strategy.grossloss) / n_loss : 0.0
    pf       = strategy.grossloss != 0.0 ? strategy.grossprofit / math.abs(strategy.grossloss) : 0.0
    expect   = n_closed > 0 ? (win_rate / 100.0) * (avg_win / math.max(avg_loss, 0.01)) - (1.0 - win_rate / 100.0) : 0.0

    table.cell(stats, 0, 0, "STATISTICS", text_color = color.white, bgcolor = color.new(color.navy, 50), text_size = size.normal)
    table.cell(stats, 1, 0, "",           text_color = color.white, bgcolor = color.new(color.navy, 50), text_size = size.normal)

    table.cell(stats, 0, 1, "Trades",  text_color = color.gray,  text_size = size.small)
    table.cell(stats, 1, 1, str.tostring(n_closed) + "  " + str.tostring(n_wins) + "W/" + str.tostring(n_loss) + "L", text_color = color.white, text_size = size.small)

    wr_col = win_rate >= 50.0 ? color.lime : color.red
    table.cell(stats, 0, 2, "Win Rate",     text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 2, str.tostring(win_rate, "#.#") + "%", text_color = wr_col, text_size = size.small)

    pf_col = pf >= 1.5 ? color.lime : pf >= 1.0 ? color.yellow : color.red
    table.cell(stats, 0, 3, "Profit Factor", text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 3, str.tostring(pf, "#.##"),              text_color = pf_col,    text_size = size.small)

    net_pnl = strategy.netprofit
    pnl_col = net_pnl >= 0.0 ? color.lime : color.red
    table.cell(stats, 0, 4, "Net P&L",   text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 4, str.tostring(net_pnl, "#.##"), text_color = pnl_col, text_size = size.small)

    table.cell(stats, 0, 5, "Max DD",    text_color = color.gray,   text_size = size.small)
    table.cell(stats, 1, 5, str.tostring(strategy.max_drawdown, "#.##"), text_color = color.orange, text_size = size.small)

    table.cell(stats, 0, 6, "Avg Win",   text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 6, str.tostring(avg_win,  "#.##"), text_color = color.lime, text_size = size.small)

    table.cell(stats, 0, 7, "Avg Loss",  text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 7, str.tostring(avg_loss, "#.##"), text_color = color.red,  text_size = size.small)

    exp_col = expect >= 0.0 ? color.lime : color.red
    table.cell(stats, 0, 8, "Expectancy", text_color = color.gray, text_size = size.small)
    table.cell(stats, 1, 8, str.tostring(expect, "#.###") + "R",  text_color = exp_col, text_size = size.small)

// =============================================================
// SETUP CHECKLIST — appears the moment a zone is liquidated (state != 0)
// and disappears once the cycle resolves (entry fires or setup expires).
// Each condition checks off live as it's met, so "why hasn't it entered
// yet" is visible on the chart instead of a guessing game.
// =============================================================

var table checklist = table.new(position.bottom_right, 2, 7, bgcolor = color.new(color.black, 75), border_width = 1, border_color = color.gray)

f_chk_cell(bool done, bool applicable) =>
    txt = not applicable ? "N/D" : done ? "✓" : "⏳"
    col = not applicable ? color.gray : done ? color.lime : color.orange
    [txt, col]

if render_bar and show_checklist and state != 0
    dir_str = (state == 1 or state == 3) ? "BAJISTA" : "ALCISTA"
    dir_col = (state == 1 or state == 3) ? color.red : color.teal
    table.cell(checklist, 0, 0, "SETUP " + dir_str, text_color = color.white, bgcolor = color.new(dir_col, 30), text_size = size.normal)
    table.cell(checklist, 1, 0, "",                 text_color = color.white, bgcolor = color.new(dir_col, 30), text_size = size.normal)

    mss_done = state == 3 or state == 4
    fvg_done = mss_done and not na(fvg_top)

    [c1txt, c1col] = f_chk_cell(true, true)
    table.cell(checklist, 0, 1, "Zona Liquidada",      text_color = color.gray, text_size = size.small)
    table.cell(checklist, 1, 1, c1txt, text_color = c1col, text_size = size.small)

    [c2txt, c2col] = f_chk_cell(mss_done, true)
    table.cell(checklist, 0, 2, "Cambio Estructura",   text_color = color.gray, text_size = size.small)
    table.cell(checklist, 1, 2, c2txt, text_color = c2col, text_size = size.small)

    // The imbalance rows only exist in the retest mode; in the default mode
    // the break IS the entry and there is nothing further to tick off.
    if use_fvg_entry
        [c3txt, c3col] = f_chk_cell(fvg_done, true)
        table.cell(checklist, 0, 3, "Imbalance Formado",   text_color = color.gray, text_size = size.small)
        table.cell(checklist, 1, 3, c3txt, text_color = c3col, text_size = size.small)

        [c4txt, c4col] = f_chk_cell(cyc_touched, mss_done)
        table.cell(checklist, 0, 4, "Retest de Zona",      text_color = color.gray, text_size = size.small)
        table.cell(checklist, 1, 4, c4txt, text_color = c4col, text_size = size.small)

        [c5txt, c5col] = f_chk_cell(cyc_close_ok, mss_done and req_close_fvg)
        table.cell(checklist, 0, 5, "Cierre Confirmación", text_color = color.gray, text_size = size.small)
        table.cell(checklist, 1, 5, c5txt, text_color = c5col, text_size = size.small)
    else
        [c3txt, c3col] = f_chk_cell(state == 3 or state == 4, true)
        table.cell(checklist, 0, 3, "ENTRADA PENDIENTE",   text_color = color.gray, text_size = size.small)
        table.cell(checklist, 1, 3, c3txt, text_color = c3col, text_size = size.small)

        [c4txt, c4col] = f_chk_cell(can_trade_entry, state == 3 or state == 4)
        table.cell(checklist, 0, 4, "Sesión Abierta",      text_color = color.gray, text_size = size.small)
        table.cell(checklist, 1, 4, c4txt, text_color = c4col, text_size = size.small)

    // Volatility of the open symbol (index or own daily ATR %), last row.
    if show_vol_cell
        vol_row = use_fvg_entry ? 6 : 5
        table.cell(checklist, 0, vol_row, "Volatilidad", text_color = color.gray, text_size = size.small)
        table.cell(checklist, 1, vol_row, vol_txt,       text_color = color.white, text_size = size.small)

// =============================================================
// ALERTS
// =============================================================

alertcondition(any_hs,       title = "Sweep HIGH",         message = "Sweep HIGH - watch for bearish MSS")
alertcondition(any_ls,       title = "Sweep LOW",          message = "Sweep LOW - watch for bullish MSS")
alertcondition(bear_mss,     title = "MSS Bear Confirmed", message = "Bearish MSS confirmed - FVG active")
alertcondition(bull_mss,     title = "MSS Bull Confirmed", message = "Bullish MSS confirmed - FVG active")
alertcondition(short_valid, title = "SHORT Entry",        message = "Liquidity Algo SHORT | POI swept + CE broken | Entry: {{close}}")
alertcondition(long_valid,  title = "LONG Entry",         message = "Liquidity Algo LONG  | POI swept + CE broken | Entry: {{close}}")
alertcondition(eqh_new,      title = "EQH Formed",         message = "Equal High detected - liquidity pool above")
alertcondition(eql_new,      title = "EQL Formed",         message = "Equal Low detected - liquidity pool below")

// Proximity alerts - price approaching a POI zone (fires once on entry)
alertcondition(pdh_near_alert,   title = "Price near PDH",     message = "Price approaching PDH (Previous Day High)")
alertcondition(pdl_near_alert,   title = "Price near PDL",     message = "Price approaching PDL (Previous Day Low)")
alertcondition(pwh_near_alert,   title = "Price near PWH",     message = "Price approaching PWH (Previous Week High)")
alertcondition(pwl_near_alert,   title = "Price near PWL",     message = "Price approaching PWL (Previous Week Low)")
alertcondition(eqh_near_alert,   title = "Price near EQH",     message = "Price approaching Equal Highs liquidity pool")
alertcondition(eql_near_alert,   title = "Price near EQL",     message = "Price approaching Equal Lows liquidity pool")

// Liquidation alerts - the exact bar a POI zone gets crossed/filled. The
// "title" here becomes the alert's default name in TradingView, so a push
// notification from one of these shows the zone that just got liquidated.
alertcondition(pdh_liq,   title = "POI Liquidado: PDH",      message = "POI Liquidado: PDH (Previous Day High)")
alertcondition(pdl_liq,   title = "POI Liquidado: PDL",      message = "POI Liquidado: PDL (Previous Day Low)")
alertcondition(pwh_liq,   title = "POI Liquidado: PWH",      message = "POI Liquidado: PWH (Previous Week High)")
alertcondition(pwl_liq,   title = "POI Liquidado: PWL",      message = "POI Liquidado: PWL (Previous Week Low)")
alertcondition(eqh_liq,   title = "POI Liquidado: EQH",      message = "POI Liquidado: Equal Highs")
alertcondition(eql_liq,   title = "POI Liquidado: EQL",      message = "POI Liquidado: Equal Lows")
